# Copy to backend/.env and set a domain pointing to your server.
FELT_DOMAIN=photos.example.com
# nosh weights are imported locally; they are never downloaded into the image.
FELT_MODEL=nosh-mnn
# Optional for Tencent Cloud hosts: https://mirrors.cloud.tencent.com/pypi/simple
# PIP_INDEX_URL=https://pypi.org/simple
# Set to 0 only when importing a verified model into the runtime volume.
FELT_PRELOAD_MODEL=1
