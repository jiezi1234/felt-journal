# Copy to backend/.env and set a domain pointing to your server.
FELT_DOMAIN=photos.example.com
# nosh weights are imported locally; they are never downloaded into the image.
FELT_MODEL=nosh-mnn
# Optional local image classification (no per-request provider charges).
# Import the verified weights with backend.prepare_classification_model first.
FELT_CLASSIFICATION=mobilenet-v2
# Optional for Tencent Cloud hosts: https://mirrors.cloud.tencent.com/pypi/simple
# PIP_INDEX_URL=https://pypi.org/simple
# Optional Debian mirror origin (contains /debian and /debian-security).
# DEBIAN_MIRROR=https://mirrors.cloud.tencent.com
# Set to 0 only when importing a verified model into the runtime volume.
FELT_PRELOAD_MODEL=1

# Production login: keep actual values in the ignored backend/.env.production.
# AppSecret must remain on the server; sessions are issued after wx.login validation.
# FELT_WECHAT_APP_ID=wx0000000000000000
# FELT_WECHAT_APP_SECRET=
# FELT_PRODUCTION_IMAGE=felt-extractor-auth:your-verified-version
# FELT_EXTRACT_PER_MINUTE=6
# FELT_EXTRACT_PER_DAY=60
