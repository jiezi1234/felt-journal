/* Common touch feedback and dialog close target. */
button.ui-pressed { opacity:.76; transform:scale(.97); }
.modal-overlay button.ui-close { flex-shrink:0; width:44px; min-width:44px; max-width:44px; height:44px; min-height:44px; margin:0; padding:0; border:0; border-radius:50%; background:#F2EEE7; color:#78685B; font-size:26px; font-weight:400; line-height:42px; box-shadow:none; }
.modal-overlay button.ui-close[disabled] { opacity:.4; }
