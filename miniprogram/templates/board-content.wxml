<view wx:if="{{loading}}" class="loading">正在读取板面…</view>
<view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重试读取</button></view>
<block wx:else>
  <view class="row board-heading"><view><view wx:if="{{!embedded}}" class="section-title">{{dateLabel}}</view><view wx:if="{{editable}}" class="muted">{{saveState}}</view></view><button wx:if="{{editable && !embedded}}" class="primary" disabled="{{task || recovering}}" bindtap="done">完成</button><button wx:elif="{{!editable && canEdit}}" disabled="{{task || recovering}}" bindtap="edit">编辑</button></view>
  <view wx:if="{{saveError}}" class="error">{{saveError}}<button class="ghost" bindtap="retrySave">重试保存</button></view>
  <view class="editor-stage"><felt-board id="board" layout="fit" style="height:100%;" covered="{{!!drawer || !!task || !!placing}}" landing-id="{{placing.id || ''}}" model="{{model}}" editable="{{editable}}" selected="{{selected}}" bind:landingready="stickerTarget" bind:select="select" bind:change="placementChanged" bind:transform="transform" bind:memory="memory" /></view>
  <view class="caption">{{count ? count + ' 件记忆' : '暂无记忆'}}{{editable && count ? ' · 拖动布置' : ''}}</view>
  <block wx:if="{{editable}}">
    <view class="editor-toolbar"><button id="add-photo" class="primary" disabled="{{task || recovering}}" bindtap="sourceSheet">{{isTheme ? '＋ 添加记忆' : '＋ 添加照片'}}</button></view>
    <view class="row history-tools"><button id="undo-layout" class="ghost grow" disabled="{{!canUndo || task || recovering}}" bindtap="undo" aria-label="撤销上一步布局调整">↶ 撤销</button><button id="redo-layout" class="ghost grow" disabled="{{!canRedo || task || recovering}}" bindtap="redo" aria-label="重做布局调整">↷ 重做</button></view>
    <view class="selected-tools" style="visibility:{{selected ? 'visible' : 'hidden'}};">
      <view class="row selected-heading"><text class="muted">已选中</text><button id="edit-memory" class="ghost small" disabled="{{task || recovering}}" bindtap="memory">{{embedded ? '文字 / 分类' : '详情 ↗'}}</button></view>
      <view class="selection-actions"><button id="layer-front" class="secondary" data-direction="front" disabled="{{!canBringToFront || task || recovering}}" bindtap="layer">↑ 置顶</button><button id="layer-back" class="secondary" data-direction="back" disabled="{{!canSendToBack || task || recovering}}" bindtap="layer">↓ 置底</button><button id="remove-placement" class="danger" disabled="{{task || recovering}}" bindtap="remove">移除摆放</button></view>
    </view>
    <button id="add-from-library" class="ghost full library-add" disabled="{{task || recovering || openingLibrary}}" bindtap="library">{{isTheme ? '从记忆库添加' : '找回当天记忆'}}</button>
  </block>
  <button wx:if="{{!editable && count}}" id="export-board" class="primary full space board-export" bindtap="exportBoard">导出 / 分享 ↗</button>
  <button wx:if="{{!editable && !count && canEdit}}" class="primary full space" bindtap="sourceSheet">＋ 添加记忆</button>
</block>
