<view wx:if="{{journalPicker}}" class="journal-picker-veil {{pickerClosing ? 'journal-picker-closing' : ''}}" catchtouchmove="stop">
  <view class="journal-picker-scrim" bindtap="closeJournalPicker" />
  <view class="journal-picker-card" role="dialog" aria-modal="true" aria-label="{{journalPicker === 'calendar' ? '月历时光' : '全部主题板'}}">
    <view class="journal-picker-heading"><view class="section-title">{{journalPicker === 'calendar' ? '月历时光' : '全部主题板'}}</view><button id="close-journal-picker" class="journal-close" aria-label="关闭卡片" disabled="{{pickerClosing}}" bindtap="closeJournalPicker">×</button></view>
    <block wx:if="{{journalPicker === 'calendar'}}">
      <view class="journal-month-controls"><button id="journal-previous-month" class="journal-month-arrow" aria-label="上个月" disabled="{{pickerClosing}}" bindtap="previousMonth">‹</button><text>{{journalYear}}年{{journalMonth}}月</text><button id="journal-next-month" class="journal-month-arrow" aria-label="下个月" disabled="{{!canNextMonth || pickerClosing}}" bindtap="nextMonth">›</button></view>
      <scroll-view scroll-y class="journal-calendar-scroll {{calendarCells.length === 42 ? 'journal-calendar-six-weeks' : calendarCells.length === 28 ? 'journal-calendar-four-weeks' : ''}}">
        <view wx:for="{{[journalYear + '-' + journalMonth]}}" wx:key="*this" class="journal-picker-content">
          <view class="journal-month-week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
          <view class="journal-month-grid"><block wx:for="{{calendarCells}}" wx:key="id"><view wx:if="{{item.blank}}" class="journal-calendar-blank" /><button wx:else class="journal-calendar-day {{item.date === dailyDate ? 'journal-calendar-selected' : ''}} {{item.today ? 'journal-calendar-today' : ''}}" data-date="{{item.date}}" disabled="{{item.future || pickerClosing}}" aria-label="{{item.date + (item.images.length ? '，展示' + item.images.length + '件记忆' : '，暂无记忆') + (item.date === dailyDate ? '，已选中' : '')}}" bindtap="chooseDate"><text>{{item.day}}</text><view class="journal-date-objects"><block wx:for="{{item.images}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="key"><image wx:if="{{!previewErrors[photo.key]}}" class="journal-preview-object journal-preview-{{photoIndex}} {{previewReady[photo.key] ? 'journal-preview-ready' : ''}}" src="{{photo.path}}" data-key="{{photo.key}}" bindload="journalPreviewLoaded" binderror="journalPreviewFailed" mode="aspectFit" /><view wx:else class="journal-preview-missing" aria-label="物体图片暂不可用" /></block></view><view class="journal-memory-dot {{item.images.length ? 'has-memory' : ''}}" /></button></block></view>
        </view>
      </scroll-view>
      <view class="journal-calendar-footer"><view class="journal-calendar-legend"><view class="journal-memory-dot has-memory" />有记忆的日子</view><button class="journal-footer-button" disabled="{{pickerClosing}}" bindtap="memories">记忆库</button><button id="journal-today" class="journal-footer-button" disabled="{{pickerClosing}}" bindtap="returnToday">回到今天</button></view>
    </block>
    <scroll-view wx:else scroll-y class="journal-theme-picker-scroll"><view class="journal-theme-grid"><button wx:for="{{journalThemes}}" wx:key="id" class="journal-theme-choice {{item.id === date ? 'journal-theme-choice-active' : ''}}" style="animation-delay:{{index < 8 ? index * 24 : 0}}ms;" data-id="{{item.id}}" aria-label="{{item.title + '，' + item.count + '件记忆'}}" disabled="{{pickerClosing}}" bindtap="chooseTheme"><view wx:if="{{item.images.length}}" class="journal-theme-objects"><block wx:for="{{item.images}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="key"><image wx:if="{{!previewErrors[photo.key]}}" class="journal-preview-object journal-preview-{{photoIndex}} {{previewReady[photo.key] ? 'journal-preview-ready' : ''}}" src="{{photo.path}}" data-key="{{photo.key}}" bindload="journalPreviewLoaded" binderror="journalPreviewFailed" mode="aspectFit" /><view wx:else class="journal-preview-missing" aria-label="物体图片暂不可用" /></block></view><view wx:else class="journal-theme-placeholder">＋</view><text class="journal-theme-choice-name">{{item.title}}</text><text class="muted">{{item.count}} 件记忆</text></button><button id="new-theme" class="journal-theme-choice journal-theme-new" disabled="{{pickerClosing}}" bindtap="createJournalTheme"><text>＋</text><text>新建主题板</text></button></view></scroll-view>
  </view>
</view>
