page { background:#E8EDE7; color:#302F2B; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; font-size:15px; line-height:1.6; }
view,button,image,textarea { box-sizing:border-box; }
.page { max-width:560px; margin:auto; padding:20px 20px calc(32px + env(safe-area-inset-bottom)); }
.paper { background:#F7F2E9; border:1px solid #FAF7EF; border-radius:24px; padding:22px 18px; margin-top:24px; box-shadow:0 8px 24px rgba(48,47,43,.055); }
.title { font:600 27px/1.4 "Noto Serif SC","Songti SC",SimSun,serif; margin:12px 0 24px; }
.section-title { font:500 20px/1.5 "Songti SC",SimSun,serif; }
.row { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.stack { display:flex; flex-direction:column; gap:12px; }
.muted { color:#73746D; font-size:13px; }.caption { color:#73746D; font-size:13px; margin:16px 0; text-align:center; }
.chip { background:#F7F2E9; color:#396848; border-radius:30px; padding:6px 12px; display:inline-block; font-size:13px; }
.divider { border-bottom:1px dashed #D2C4BB; margin:18px 0; }
button { margin:0; padding:12px 16px; min-height:44px; line-height:1.4; font-size:15px; border-radius:14px; background:#F7F2E9; color:#396848; font-weight:500; }
button::after { border:0; }
button.primary { background:#4D7D5B; color:#F7F2E9; box-shadow:0 3px 0 #395D43; min-height:50px; }
button.secondary { background:#E9E9E0; color:#396848; }
button.ghost { background:transparent; padding:10px 6px; }
button.danger { background:transparent; color:#A44737; }
button[disabled] { background:#D9DDD5; color:#73746D; box-shadow:none; }
.error { padding:18px; background:#F7F2E9; color:#944835; border-radius:16px; margin:16px 0; font-size:14px; }
.full { width:100%; }.space { margin-top:24px; }.small { font-size:13px; }.grow { flex:1; }
button.full { width:100%; display:block; } .row > button { width:auto; flex-shrink:0; } .row > button.grow { width:0; min-width:0; flex:1; } button.ghost { width:auto; }
button.ghost,button.primary,button.secondary,button.danger { margin:0; } .row > button { margin:0; }
.loading { padding:72px 16px; text-align:center; color:#73746D; }
.page.with-main-nav { padding-bottom:calc(100px + env(safe-area-inset-bottom)); }
@media (max-width:350px) { .page { padding-left:16px; padding-right:16px; }.paper { padding:18px 14px; }.title { font-size:24px; } }
