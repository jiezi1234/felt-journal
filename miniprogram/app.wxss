/* White gallery: quiet surfaces, generous spacing, one restrained accent. */
page { background:#FAFCFB; background-image:linear-gradient(155deg,#FFFFFF 0%,#F3F7F5 45%,#FFFFFF 85%); color:#263530; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; font-size:15px; line-height:1.65; }
view,button,image,textarea,input { box-sizing:border-box; }
.page { max-width:560px; margin:auto; padding:24px 24px calc(36px + env(safe-area-inset-bottom)); }
.paper { background:#FFFFFF; border:1px solid #E9EEEB; border-radius:24px; padding:24px 20px; margin-top:28px; box-shadow:0 8px 30px rgba(38,53,48,.025); }
.title { font-size:28px; font-weight:600; line-height:1.5; letter-spacing:-.6px; margin:22px 0 28px; }
.section-title { font-size:19px; font-weight:600; line-height:1.5; letter-spacing:-.3px; }
.eyebrow { color:#68766C; font-size:10px; letter-spacing:2.5px; font-weight:500; }
.page-heading { margin:26px 0 30px; }
.page-heading .title { margin:8px 0 10px; }
.page-subtitle { color:#68766C; font-size:13px; line-height:1.8; }
.row { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.stack { display:flex; flex-direction:column; gap:14px; }
.muted { color:#68766C; font-size:13px; }
.caption { color:#68766C; font-size:12px; line-height:1.8; margin:20px 0; text-align:center; }
.chip { background:#F0F4F2; color:#586D62; border:1px solid #E7EEEA; border-radius:30px; padding:5px 11px; display:inline-block; font-size:12px; }
.divider { border-bottom:1px solid #EDF0EE; margin:22px 0; }
button { margin:0; padding:13px 16px; min-height:46px; line-height:1.5; font-size:14px; border:1px solid #E7ECE9; border-radius:16px; background:#FFFFFF; color:#435A4E; font-weight:500; }
button::after { border:0; }
button.primary { background:#344C40; background-image:linear-gradient(115deg,#2F443A,#486253); color:#FFFFFF; border-color:transparent; box-shadow:0 6px 16px rgba(52,76,64,.1); min-height:52px; }
button.secondary { background:#F2F5F3; color:#435A4E; border-color:#EBEFEC; }
button.ghost { background:transparent; border-color:transparent; padding:10px 6px; }
button.danger { background:transparent; border-color:transparent; color:#A2554C; }
button[disabled] { background:#F0F2F1; color:#929B95; border-color:transparent; box-shadow:none; }
.error { padding:18px; background:#FBF4F2; color:#97574C; border:1px solid #F1E3DF; border-radius:16px; margin:16px 0; font-size:14px; }
.full { width:100%; }.space { margin-top:24px; }.small { font-size:13px; }.grow { flex:1; }
button.full { width:100%; display:block; }
.row > button { width:auto; flex-shrink:0; margin:0; }
.row > button.grow { width:0; min-width:0; flex:1; }
button.ghost { width:auto; }
button.ghost,button.primary,button.secondary,button.danger { margin:0; }
.loading { padding:80px 16px; text-align:center; color:#68766C; font-size:13px; }
.page.with-main-nav { padding-bottom:calc(110px + env(safe-area-inset-bottom)); }
@media (max-width:350px) { .page { padding-left:18px; padding-right:18px; }.paper { padding:20px 14px; }.title { font-size:25px; }.section-title { font-size:18px; }.row { gap:8px; } }
