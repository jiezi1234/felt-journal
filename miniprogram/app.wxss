@import "./styles/controls.wxss";
/* Paper, ink and a little butter yellow. See docs/Nosh风格适配.md. */
page { background:#F5F5F5; background-image:linear-gradient(160deg,#FFFDF8 0%,#F5F5F5 38%,#F5F5F5 100%); color:#262321; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; font-size:15px; line-height:1.65; }
view,button,image,textarea,input { box-sizing:border-box; }
.page { max-width:560px; margin:auto; padding:20px 20px calc(36px + env(safe-area-inset-bottom)); }
.paper { background:#FFFFFF; border:1px solid #FFFFFF; border-radius:30px; padding:24px 20px; margin-top:24px; box-shadow:0 5px 20px rgba(65,48,36,.035); }
.title { font-size:28px; font-weight:700; line-height:1.45; letter-spacing:.1px; margin:22px 0 28px; }
.section-title { font-size:19px; font-weight:600; line-height:1.5; color:#5E4B40; }
.eyebrow { color:#95877D; font-size:10px; letter-spacing:1.6px; font-weight:500; }
.page-heading { margin:16px 0 22px; }
.page-heading .title { margin:0; }
.page-subtitle { color:#8B7E74; font-size:13px; line-height:1.8; }
.row { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.stack { display:flex; flex-direction:column; gap:14px; }
.muted { color:#847A72; font-size:13px; }
.caption { color:#847A72; font-size:12px; line-height:1.8; margin:20px 0; text-align:center; }
.chip { background:#FFF5DB; color:#786045; border:1px solid #F6E9C9; border-radius:30px; padding:5px 11px; display:inline-block; font-size:12px; }
.divider { border-bottom:1px dashed #E9E3DB; margin:22px 0; }
button { margin:0; padding:13px 16px; min-height:46px; line-height:1.5; font-size:14px; border:1px solid #E9E5DF; border-radius:28px; background:#FFFFFF; color:#5E4B40; font-weight:500; }
button::after { border:0; }
button.primary { background:#171716; color:#FFFFFF; border-color:transparent; box-shadow:0 5px 12px rgba(38,35,33,.1); min-height:52px; font-weight:600; }
button.secondary { background:#F4F2EE; color:#69594C; border-color:transparent; }
button.ghost { background:transparent; border-color:transparent; padding:10px 6px; }
button.danger { background:transparent; border-color:transparent; color:#A2554C; }
button[disabled] { background:#EFEDE9; color:#A39A91; border-color:transparent; box-shadow:none; }
.error { padding:18px; background:#FBF1ED; color:#97574C; border:1px solid #F1E3DF; border-radius:20px; margin:16px 0; font-size:14px; }
.full { width:100%; }.space { margin-top:24px; }.small { font-size:13px; }.grow { flex:1; }
button.full { width:100%; display:block; }
.row > button { width:auto; flex-shrink:0; margin:0; }
.row > button.grow { width:0; min-width:0; flex:1; }
button.ghost { width:auto; }
button.ghost,button.primary,button.secondary,button.danger { margin:0; }
.loading { padding:80px 16px; text-align:center; color:#847A72; font-size:13px; }
.page.with-main-nav { padding-bottom:calc(122px + env(safe-area-inset-bottom)); }
.sheet-binding { position:absolute; left:9px; top:30px; bottom:28px; width:7px; display:flex; flex-direction:column; justify-content:space-between; pointer-events:none; }
.sheet-binding view { width:7px; height:7px; border:1px solid #DDD6CB; border-radius:50%; background:#F5F3EF; box-shadow:inset 0 1px 2px rgba(85,67,52,.05); }
@media (max-width:350px) { .page { padding-left:16px; padding-right:16px; }.paper { padding:20px 14px; }.title { font-size:25px; }.section-title { font-size:18px; }.row { gap:8px; } }

/* Native navigation is outside 100vh; the custom tab bar is inside it. */
.page.screen-page { height:100vh; min-height:0; padding-top:10px; padding-bottom:calc(12px + env(safe-area-inset-bottom)); display:flex; flex-direction:column; }
.page.screen-page.with-main-nav { padding-bottom:calc(110px + env(safe-area-inset-bottom)); }
.screen-page>.row,.screen-page>.page-heading { flex-shrink:0; }
.screen-page .page-heading { margin:6px 0 12px; }
.screen-page .page-heading .title { margin:0; font-size:24px; }
.screen-page .loading { flex:1; display:flex; align-items:center; justify-content:center; padding:16px; }
.screen-page .error { margin:6px 0; padding:10px 12px; font-size:12px; }
.screen-page .space { margin-top:10px; }
.screen-page .divider { margin:10px 0; }
.screen-header { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:46px; flex-shrink:0; margin-bottom:8px; }
.screen-header .title { font-size:22px; margin:0; }
.screen-pagination { display:flex; flex-shrink:0; align-items:center; justify-content:space-between; gap:12px; padding-top:8px; }
.screen-pagination button { min-width:64px; min-height:44px; padding:10px 16px; }
.screen-pagination text { color:#95877D; font-size:12px; }
