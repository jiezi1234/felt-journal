.themes-page { gap:8px; }
.theme-create { font-size:13px; padding:10px 18px; }
.paper.theme-card { margin:0; padding:12px; flex:1; min-height:0; display:flex; flex-direction:column; border-radius:28px; }
button.theme-open { flex:1; min-height:0; width:100%; padding:0; display:flex; flex-direction:column; background:transparent; border:0; text-align:left; border-radius:20px; }
.theme-cover { flex:1; min-height:0; width:100%; border:6px solid #493527; border-radius:22px; display:flex; align-items:center; justify-content:center; gap:8px; padding:12px; }
.theme-cover image { width:28%; height:60%; }
.theme-heading { width:100%; padding:12px 4px 4px; flex-shrink:0; align-items:center; }
.theme-name { min-width:0; font-size:19px; font-weight:600; color:#715643; line-height:1.5; word-break:break-all; }
.theme-heading>.muted { white-space:nowrap; flex-shrink:0; }
.theme-actions { flex-shrink:0; padding-top:4px; margin-top:8px; border-top:1px dashed #E9E0D3; }
.empty-theme { flex:1; min-height:0; margin:0; display:flex; align-items:center; justify-content:center; background:linear-gradient(145deg,#FFFFFF,#FFF9EA); border:1px dashed #E6DBCA; }
.theme-form-overlay { position:fixed; inset:0; z-index:140; padding:16px 16px calc(16px + env(safe-area-inset-bottom)); display:flex; align-items:flex-end; justify-content:center; }
.theme-form-scrim { position:absolute; inset:0; background:rgba(43,35,28,.28); }
.paper.theme-form { position:relative; width:100%; max-width:520px; margin:0; padding:24px; background:#FFFDFA; }
.theme-input { height:52px; border:1px solid #E8DDC9; border-radius:18px; background:#FCFAF5; padding:0 14px; margin:16px 0; font-size:15px; }
