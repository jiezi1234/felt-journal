<view class="page screen-page memories-page">
  <view class="screen-header"><button class="ghost" bindtap="back">‹ 返回</button><view class="title">{{targetId ? '选择记忆' : '记忆分类'}}</view><view class="header-spacer" /></view>
  <view wx:if="{{targetId}}" class="target-label muted">添加到「{{targetTitle}}」</view>
  <view class="paper filter-paper">
    <view wx:if="{{!targetDaily}}" class="row scope-tabs"><button id="scope-all" class="grow {{scope === 'all' ? 'active' : ''}}" data-scope="all" disabled="{{loading}}" bindtap="scope">全部时间</button><button id="scope-month" class="grow {{scope === 'month' ? 'active' : ''}}" data-scope="month" disabled="{{loading}}" bindtap="scope">按月查看</button></view>
    <picker wx:if="{{!targetDaily && scope === 'month'}}" id="month-picker" mode="date" fields="month" value="{{month}}" end="{{maxMonth}}" disabled="{{loading}}" bindchange="month"><view class="month-choice">{{monthLabel}}<text>⌄</text></view></picker>
    <view class="category-chips"><button wx:for="{{categories}}" wx:key="name" id="category-{{index}}" data-category="{{item.value}}" class="category {{category === item.value ? 'active' : ''}}" disabled="{{loading}}" aria-label="{{item.name + '，' + item.count + '件' + (category === item.value ? '，已选' : '')}}" bindtap="category">{{item.name}}<text class="category-count">{{item.count}}</text></button></view>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button class="ghost" bindtap="refresh">重试读取</button></view>
  <block wx:else>
    <view id="results" class="results-heading">{{total}} 件记忆</view>
    <view wx:if="{{!total}}" class="paper empty-result">
      <view class="section-title">{{emptyTitle}}</view>
      <button wx:if="{{category}}" id="clear-category" class="secondary full space" bindtap="clearCategory">查看全部分类</button>
      <button wx:if="{{scope === 'month'}}" class="ghost full space" bindtap="allTime">查看全部时间</button>
      <button wx:if="{{!targetId && !category && scope === 'all'}}" class="primary full space" bindtap="record">＋ 记录今天</button>
    </view>
    <view wx:else class="memory-grid" style="grid-template-rows:repeat({{pageSize / 2}}, minmax(0,1fr));">
      <block wx:for="{{groups}}" wx:key="date"><view wx:for="{{item.items}}" wx:for-item="memory" wx:key="id" class="memory-tile">
        <button class="memory-row" data-id="{{memory.id}}" disabled="{{opening || placing || memory.placed}}" bindtap="open">
          <view class="memory-thumb"><image wx:if="{{!memory.missing}}" src="{{memory.path}}" mode="aspectFit" data-id="{{memory.id}}" data-path="{{memory.path}}" binderror="imageError" /><text wx:else class="missing-thumb">图片缺失</text></view>
          <view class="memory-copy"><text class="memory-category">{{memory.category}}</text><text wx:if="{{memory.placed}}" class="muted">已添加</text><text wx:elif="{{targetId}}" class="memory-arrow">＋</text></view>
          <view wx:if="{{memory.excerpt}}" class="memory-excerpt">{{memory.excerpt}}</view>
        </button>
        <button wx:if="{{!targetId}}" class="ghost memory-date" data-date="{{item.date}}" disabled="{{opening}}" bindtap="board" aria-label="{{item.label + '，查看整板'}}">{{memory.date}} ↗</button>
      </view></block>
    </view>
    <view wx:if="{{total}}" class="screen-pagination"><button id="previous-page" class="secondary" disabled="{{!hasPrevious || placing}}" bindtap="previous">‹ 上一页</button><text>{{page}} / {{pageCount}}</text><button id="next-page" class="secondary" disabled="{{!hasNext || placing}}" bindtap="next">下一页 ›</button></view>
  </block>
</view>

<memory-card wx:if="{{memoryCardId}}" id="memory-card" memory-id="{{memoryCardId}}" bind:close="closeMemoryCard" bind:change="memoryCardChanged" />
