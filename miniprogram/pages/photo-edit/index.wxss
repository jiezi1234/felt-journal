.crop-page .title { margin-bottom:18px; font-size:25px; }
.source-tabs { background:#EEF3EF; padding:4px; border-radius:18px; }
.source-tabs button { background:transparent; font-size:14px; }
.source-tabs button.active,.ratio-row button.active { background:#435E4E; color:#FFFFFF; }
.source-hint { margin:12px 0; min-height:42px; }
.crop-stage { position:relative; width:100%; height:320px; overflow:hidden; border-radius:18px; background:#E9EEEB; }
.crop-canvas { width:100%; height:320px; }
.crop-handle { position:absolute; z-index:10; width:44px; height:44px; }
.stage-status { position:absolute; inset:0; background:#E9EEEB; display:flex; align-items:center; justify-content:center; color:#68766C; }
.ratio-row,.tools-row { display:flex; gap:8px; }
.ratio-row button { flex:1; padding:12px 0; min-width:0; width:0; }
.tools-row button { flex:1; padding:12px 4px; font-size:13px; min-width:0; width:0; }
.output-canvas { position:fixed; width:1px; height:1px; left:-10000px; top:-10000px; }
.source-tabs button { border-color:transparent; }.source-tabs button.active { background:#FFFFFF; color:#344C40; box-shadow:0 2px 8px rgba(38,53,48,.04); }.ratio-row button.active { background:#E7EFE9; color:#344C40; border-color:#D7E3DA; }.crop-stage { border:1px solid #E7EEEA; }.crop-page .page-heading .title { font-size:26px; }.tools-row { flex-wrap:wrap; }
