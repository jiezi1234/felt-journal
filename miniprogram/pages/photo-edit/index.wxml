<view class="page crop-page">
  <view class="row"><button class="ghost" bindtap="back">‹ 返回记忆</button><button class="ghost" disabled="{{!ready || loading || saving || !dirty}}" bindtap="save">{{saving ? '保存中…' : '保存'}}</button></view>
  <view class="title">留下刚刚好的部分</view>
  <view class="row source-tabs">
    <button id="source-subject" class="grow {{source === 'subject' ? 'active' : ''}}" disabled="{{saving || loading}}" data-source="subject" bindtap="source">当前物件</button>
    <button id="source-original" class="grow {{source === 'original' ? 'active' : ''}}" disabled="{{saving || loading}}" data-source="original" bindtap="source">原始照片</button>
  </view>
  <view class="muted source-hint">{{source === 'original' ? '从完整原图重新调整，原图中的背景也会保留。' : '调整已经贴在板上的图片，透明区域会保留。'}}</view>
  <view class="crop-stage">
    <canvas type="2d" id="cropCanvas" class="crop-canvas" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel" />
    <view wx:for="{{handles}}" wx:key="id" class="crop-handle" style="{{item.style}}" data-handle="{{item.id}}" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel" />
    <view wx:if="{{loading}}" class="stage-status">正在读取图片…</view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}<button disabled="{{loading}}" bindtap="retry">重试</button></view>
  <view class="caption">拖动四角调整范围，拖动框内移动选区</view>
  <view class="ratio-row"><button wx:for="{{ratios}}" wx:key="name" id="ratio-{{index}}" class="{{ratio === item.value ? 'active' : ''}}" disabled="{{!ready || loading || saving}}" data-ratio="{{item.value}}" bindtap="ratio">{{item.name}}</button></view>
  <view class="tools-row space"><button id="rotate-image" class="secondary" disabled="{{!ready || loading || saving}}" bindtap="rotate">↻ 旋转 90°</button><button id="mirror-image" class="secondary" disabled="{{!ready || loading || saving}}" bindtap="mirror">水平镜像</button><button id="reset-image" class="ghost" disabled="{{!ready || loading || saving}}" bindtap="reset">重置本次</button></view>
  <view class="divider" />
  <view class="row"><text class="muted">{{ready ? '裁剪后 ' + dimensions + ' px' : '请选择可读取的图片'}}</text><text class="muted">{{dirty ? '尚未保存' : '未作调整'}}</text></view>
  <view wx:if="{{saveError}}" class="error">{{saveError}}</view>
  <button id="save-image" class="primary full space" disabled="{{!ready || loading || saving || !dirty}}" loading="{{saving}}" bindtap="save">{{saving ? '正在保存…' : '保存到原物件'}}</button>
  <view class="caption">原始照片会保留。物件的位置、摆放尺寸和层级保持原样。</view>
</view>
<canvas type="2d" id="outputCanvas" class="output-canvas" />
