.share-colors { display:flex; justify-content:space-between; gap:8px; margin:8px 0; }.share-colors button.share-color { min-width:34px; width:34px; height:34px; min-height:34px; padding:0; border-radius:50%; margin:0; border:2px solid transparent; color:#5F5445; line-height:30px; }.share-colors button.active { border-color:#6C5B46; }.share-color::after { border:0; }
