.back { padding-left:0; }.export-paper { padding:12px; }.preview { display:block; width:100%; border-radius:16px; }.export-canvas { position:fixed; left:-3000px; top:-3000px; width:360px; height:240px; pointer-events:none; }
.page > button.back { display:inline-block; margin:0; width:auto; }
.export-actions { display:flex; flex-direction:column; gap:16px; margin-top:24px; }
.share-error { padding:12px 14px; color:#97574C; background:#FFFFFF; border-radius:14px; font-size:13px; }
.share-hint { text-align:center; padding:0 6px; }
.export-paper { padding:18px; background:linear-gradient(150deg,#FFFFFF,#F2F6F3); }.export-actions { margin-top:30px; gap:12px; }.share-error { background:#FBF4F2; }.export-paper .row { gap:16px; }.export-paper .row text:first-child { min-width:0; overflow-wrap:anywhere; }
