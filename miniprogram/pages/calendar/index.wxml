<view class="page with-main-nav">
  <view class="row"><button class="ghost" bindtap="back">‹ 返回</button><button bindtap="current">回到当月</button></view><view class="title">时光回顾</view>
  <view class="row month"><button aria-label="上个月" bindtap="previous">‹</button><text class="section-title">{{year}}年 {{month}}月</text><button aria-label="下个月" disabled="{{!canNext}}" bindtap="next">›</button></view>
  <view wx:if="{{loading}}" class="loading">正在翻阅月历…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重试读取</button></view>
  <block wx:else><view class="paper calendar-paper"><view class="muted calendar-caption">一日一格，收藏日常的微光</view><view class="week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="grid"><view wx:for="{{cells}}" wx:key="id" wx:for-index="cellIndex" class="day {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}} {{item.blank ? 'blank' : ''}}" data-date="{{item.date}}" bindtap="open"><view wx:if="{{!item.blank}}" class="number">{{item.day}}<text wx:if="{{item.today}}" class="today-dot" /></view><view class="mini-images"><block wx:for="{{item.images}}" wx:for-item="preview" wx:for-index="imageIndex" wx:key="id"><image wx:if="{{!preview.missing}}" src="{{preview.path}}" mode="aspectFit" data-cell="{{cellIndex}}" data-image="{{imageIndex}}" binderror="imageError" /><text wx:else class="missing">▧</text></block></view></view></view></view>
    <view class="caption">点击日期，展开当天完整的毛毡板</view><button id="find-month-memories" class="secondary full" bindtap="memories">按分类查找本月记忆 ↗</button><view class="paper"><view class="section-title">当月珍藏手账</view><view class="divider" /><view class="row"><view><text class="stat">{{itemCount}}</text> 件生活物件</view><view><text class="stat green">{{dayCount}}</text> 天有记录</view></view><view wx:if="{{!dayCount}}" class="caption">这个月还没有记录</view></view>
  </block>
</view>
