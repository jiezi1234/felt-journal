<view class="page with-main-nav">
  <view class="row calendar-top"><text class="eyebrow">DAYS TO REMEMBER</text><button class="ghost" bindtap="current">回到当月 ↗</button></view>
  <view class="page-heading"><view class="title">月历时光</view><view class="page-subtitle">翻过日历，重逢那些微小的美好。</view></view>
  <view class="row month"><button aria-label="上个月" bindtap="previous">‹</button><text class="section-title">{{year}}年 {{month}}月</text><button aria-label="下个月" disabled="{{!canNext}}" bindtap="next">›</button></view>
  <view wx:if="{{loading}}" class="loading">正在翻阅月历…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重试读取</button></view>
  <block wx:else>
    <view class="paper calendar-paper"><view class="muted calendar-caption">一日一格，留住生活的温度</view><view class="week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
      <view class="grid"><view wx:for="{{cells}}" wx:key="id" wx:for-index="cellIndex" class="day {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}} {{item.blank ? 'blank' : ''}}" data-date="{{item.date}}" bindtap="open"><view wx:if="{{!item.blank}}" class="number">{{item.day}}<text wx:if="{{item.today}}" class="today-dot" /></view><view class="mini-images"><block wx:for="{{item.images}}" wx:for-item="preview" wx:for-index="imageIndex" wx:key="id"><image wx:if="{{!preview.missing}}" src="{{preview.path}}" mode="aspectFit" data-cell="{{cellIndex}}" data-image="{{imageIndex}}" binderror="imageError" /><text wx:else class="missing">▧</text></block></view></view></view>
    </view>
    <view class="caption">轻点一个日子，展开完整毛毡板</view><button id="find-month-memories" class="secondary full" bindtap="memories">按分类查找本月记忆 ↗</button>
    <view class="month-summary"><view class="stat-block"><view class="stat">{{itemCount}}</view><view class="stat-label">件生活物件</view></view><view class="stat-block"><view class="stat">{{dayCount}}</view><view class="stat-label">天值得回望</view></view></view><view wx:if="{{!dayCount}}" class="caption">这个月的故事，等你慢慢写下。</view>
  </block>
</view>
