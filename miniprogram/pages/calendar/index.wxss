.calendar-page { gap:8px; }
.calendar-top,.month,.month-summary { flex-shrink:0; }
.month { min-height:44px; padding:0 2px; }
.month .section-title { font-size:18px; }
.month button { width:44px; height:44px; min-height:44px; padding:0; font-size:26px; background:transparent; border:0; }
.calendar-top .ghost { font-size:12px; }
.paper.calendar-paper { flex:1; min-height:0; margin:0; padding:12px 8px; display:flex; flex-direction:column; }
.week { display:flex; flex-shrink:0; height:28px; color:#A39483; font-size:11px; }
.week text { width:14.2857%; text-align:center; }
.grid { flex:1; min-height:0; display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:3px 0; }
.day { min-height:0; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:2px; border-radius:14px; }
.number { position:relative; flex-shrink:0; font-size:13px; line-height:20px; color:#79614B; }
.today { background:#FFF1CC; }.today .number { font-weight:700; color:#533D27; }.future { opacity:.35; }.blank { visibility:hidden; }
.today-dot { display:inline-block; width:4px; height:4px; border-radius:50%; background:#C79639; position:absolute; top:0; right:-6px; }
.mini-images { display:flex; align-items:center; justify-content:center; gap:1px; width:100%; height:27px; min-height:0; }
.mini-images image { width:47%; height:100%; }.missing { font-size:15px; color:#A68B6C; }
.month-summary { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:56px; }
button.month-stats { text-align:left; display:flex; flex-direction:column; font-size:13px; line-height:1.6; }
.month-stats .muted { font-size:11px; }.month-summary>.secondary { font-size:13px; }
@media (max-height:570px) { .calendar-page { gap:4px; }.paper.calendar-paper { padding-top:8px; padding-bottom:6px; }.mini-images { height:20px; }.number { line-height:18px; font-size:12px; }.week { height:22px; } }
