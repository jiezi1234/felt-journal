.month button { width:46px; padding:6px; font-size:24px; }.calendar-paper { padding:18px 8px 22px; }.calendar-caption { padding:0 8px 14px; border-bottom:1px dashed #D2C4BB; }.week { display:flex; margin:14px 0; font-size:13px; color:#73746D; }.week text { width:14.285714%; text-align:center; }.grid { display:flex; flex-wrap:wrap; }.day { width:14.285714%; min-height:94px; padding:6px 3px; border:2px solid transparent; border-radius:12px; }.day.today { background:#DDE9D8; border-color:#B3C9AE; }.future { color:#B7B9AF; pointer-events:none; }.blank { pointer-events:none; }.number { font-size:13px; padding-left:3px; display:flex; align-items:center; gap:3px; }.today-dot { display:inline-block; width:5px; height:5px; background:#C9A64B; border-radius:50%; }.mini-images { display:flex; flex-wrap:wrap; justify-content:center; }.mini-images image,.missing { width:32px; height:28px; }.missing { color:#A28B71; text-align:center; }.stat { font:32px serif; margin-right:4px; }.green { color:#396848; }@media (max-width:350px) { .day { min-height:90px; padding:6px 1px; }.mini-images image { width:28px; height:26px; } }
