.memory-paper { margin-top:0; }.original { width:100%; display:block; border-radius:14px; min-height:80px; }.subject-sample { background:#F6F3EC; border-radius:14px; margin:14px 0 22px; height:170px; display:flex; align-items:center; justify-content:center; }.subject-sample image { width:85%; height:140px; }.note { white-space:pre-wrap; font-size:17px; line-height:1.9; word-break:break-all; }.note-input { width:100%; min-height:140px; font-size:16px; line-height:1.8; padding:12px; border:1px solid #E9E0D3; border-radius:10px; }.text-count { text-align:right; }.category-picker { padding:12px; background:#F4F2EE; border-radius:10px; margin-top:12px; color:#6F5948; }.space-small { margin-top:10px; }
.edited-hint { margin:-12px 0 18px; }
.memory-paper { padding:18px; }.subject-sample { background:linear-gradient(145deg,#FFFCF4,#F8F1E3); border:1px solid #EEE7DE; }.memory-paper > .row { flex-wrap:wrap; }.note-input { background:#FEFCF8; padding:16px; }.note { color:#71594B; }.category-picker { border:1px solid #EEE7DE; }.memory-paper .section-title { font-size:17px; }

.memory-paper { border-radius:30px; padding:18px; }.original { border-radius:22px; }.subject-sample { height:185px; background:linear-gradient(145deg,#FFFEFA,#F5EFE2); border:1px dashed #E8DCC7; border-radius:24px; }.subject-sample image { height:150px; }.note { color:#79604E; line-height:2; padding:4px 4px 12px; }.note-input { border-radius:18px; border-color:#E8DDC9; }.category-picker { border-radius:18px; background:#FFF6DE; border-color:#F4E8C8; }
