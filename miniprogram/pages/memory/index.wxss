.memory-page { gap:10px; }.memory-page .screen-header { margin:0; }
.memory-meta { flex-shrink:0; }.memory-meta .muted { font-size:12px; }
.detail-tabs { flex-shrink:0; padding:3px; background:#F0EDE7; border-radius:26px; gap:4px; }
.detail-tabs button { min-height:40px; padding:8px 4px; font-size:12px; border:0; background:transparent; }
.detail-tabs button.active { background:#FFFFFF; color:#6C543F; }
.paper.memory-paper { flex:1; min-height:0; display:flex; flex-direction:column; padding:14px; margin:0; background:linear-gradient(145deg,#FFFFFF,#FBF8F0); }
.detail-image { display:block; width:100%; flex:1; min-height:0; border-radius:18px; }
.subject-actions { flex-shrink:0; margin-top:6px; }.subject-actions .muted { font-size:11px; }
.memory-paper .caption { flex-shrink:0; margin:6px 0 0; }
.note-input { width:100%; flex:1; min-height:0; height:0; font-size:15px; line-height:1.8; padding:10px; border:1px solid #E8DDC9; border-radius:14px; background:#FFFFFF; }
.text-count { text-align:right; font-size:11px; margin:4px 0; }
.category-picker { padding:10px 12px; background:#FFF6DE; border-radius:16px; color:#786045; font-size:13px; margin-bottom:8px; }
.note-reading { flex:1; min-height:0; height:0; }.note { white-space:pre-wrap; font-size:15px; line-height:1.9; word-break:break-all; color:#79604E; padding:4px; }
.memory-footer { flex-shrink:0; }.memory-footer>.row { margin-top:6px; }.memory-footer .row button { font-size:12px; }
@media (max-height:570px) { .memory-page { gap:6px; }.memory-footer>.row { margin-top:0; } }

.shared-hint { color:#95877D; text-align:center; font-size:11px; margin-bottom:6px; }
