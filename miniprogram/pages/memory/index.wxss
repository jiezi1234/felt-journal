.memory-paper { margin-top:0; }.original { width:100%; display:block; border-radius:14px; min-height:80px; }.subject-sample { background:#D9CBAF; border-radius:14px; margin:14px 0 22px; height:170px; display:flex; align-items:center; justify-content:center; }.subject-sample image { width:85%; height:140px; }.note { white-space:pre-wrap; font-size:17px; line-height:1.9; word-break:break-all; }.note-input { width:100%; min-height:140px; font-size:16px; line-height:1.8; padding:12px; border:1px dashed #D2C4BB; border-radius:10px; }.text-count { text-align:right; }.category-picker { padding:12px; background:#E8EDE7; border-radius:10px; margin-top:12px; color:#396848; }.space-small { margin-top:10px; }
.edited-hint { margin:-12px 0 18px; }
