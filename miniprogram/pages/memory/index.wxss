.memory-paper { margin-top:0; }.original { width:100%; display:block; border-radius:14px; min-height:80px; }.subject-sample { background:#F0F4F1; border-radius:14px; margin:14px 0 22px; height:170px; display:flex; align-items:center; justify-content:center; }.subject-sample image { width:85%; height:140px; }.note { white-space:pre-wrap; font-size:17px; line-height:1.9; word-break:break-all; }.note-input { width:100%; min-height:140px; font-size:16px; line-height:1.8; padding:12px; border:1px solid #E2E9E4; border-radius:10px; }.text-count { text-align:right; }.category-picker { padding:12px; background:#F2F5F3; border-radius:10px; margin-top:12px; color:#435A4E; }.space-small { margin-top:10px; }
.edited-hint { margin:-12px 0 18px; }
.memory-paper { padding:18px; }.subject-sample { background:linear-gradient(145deg,#F5F8F6,#EBF1ED); border:1px solid #E7EEEA; }.memory-paper > .row { flex-wrap:wrap; }.note-input { background:#FAFCFB; padding:16px; }.note { color:#43564A; }.category-picker { border:1px solid #E7EEEA; }.memory-paper .section-title { font-size:17px; }
