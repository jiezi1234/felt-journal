<view class="page screen-page memory-page">
  <view class="screen-header"><button class="ghost" bindtap="back">‹ 返回</button><view class="title">记忆</view><button wx:if="{{memory && !editing}}" class="ghost" bindtap="edit">编辑</button><button wx:elif="{{editing}}" class="ghost" bindtap="save">保存</button></view>
  <view wx:if="{{loading}}" class="loading">加载中…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view>
  <block wx:else>
    <view class="row memory-meta"><text class="muted">{{dateLabel}}</text><text class="chip">{{memory.category}}{{memory.categorySource === 'auto' ? ' · 自动' : ''}}</text></view>
    <view class="row detail-tabs"><button class="grow {{section === 'subject' ? 'active' : ''}}" data-section="subject" bindtap="section">板上物件</button><button class="grow {{section === 'original' ? 'active' : ''}}" data-section="original" bindtap="section">原图</button><button class="grow {{section === 'note' ? 'active' : ''}}" data-section="note" bindtap="section">文字</button></view>
    <view class="paper memory-paper">
      <block wx:if="{{section === 'original'}}"><image wx:if="{{!originalMissing}}" class="detail-image" src="{{memory.originalPath}}" mode="aspectFit" bindtap="preview" binderror="originalError" /><view wx:else class="error">原图无法读取，请替换照片。</view><view class="caption">点击放大</view></block>
      <block wx:elif="{{section === 'subject'}}"><image wx:if="{{!subjectMissing}}" class="detail-image" src="{{memory.subjectPath}}" mode="aspectFit" binderror="subjectError" /><view wx:else class="error">图片无法读取，请替换照片。</view><view class="row subject-actions"><text class="muted">{{memory.subjectEdited ? '已手动调整' : memory.kind === 'original' ? '保留原图' : '已提取主体'}}</text><button id="adjust-image" class="ghost small" disabled="{{!!task}}" bindtap="adjust">裁剪 / 修正</button></view></block>
      <block wx:else>
        <block wx:if="{{editing}}"><textarea class="note-input" placeholder="记点什么（选填）" maxlength="{{maxText}}" value="{{text}}" bindinput="textInput" /><view class="muted text-count">{{text.length}} / {{maxText}}</view><picker range="{{categories}}" value="{{category}}" bindchange="categoryInput"><view class="category-picker">分类：{{categories[category]}}　⌄</view></picker><view wx:if="{{saveError}}" class="error">{{saveError}}</view><button class="primary full" bindtap="save">保存</button></block>
        <scroll-view wx:elif="{{memory.text}}" scroll-y class="note-reading"><view class="note">{{memory.text}}</view></scroll-view><button wx:else class="secondary full" bindtap="edit">写下记忆</button>
      </block>
    </view>
    <view class="memory-footer"><view wx:if="{{usageCount > 1}}" class="shared-hint">用于 {{usageCount}} 块板，修改会同步</view><view class="row"><button class="ghost" bindtap="replace">替换照片</button><button id="delete-memory" class="danger" bindtap="remove">删除记忆</button></view></view>
  </block>
</view>
<photo-panel note-open="{{photoNoteOpen}}" note-text="{{photoNoteText}}" note-error="{{photoNoteError}}" bind:noteopen="openPhotoNote" bind:noteinput="photoNoteInput" task="{{task}}" bind:retry="retryPhoto" bind:original="originalPhoto" bind:cancel="cancelPhoto" />
