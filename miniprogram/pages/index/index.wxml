<view class="page screen-page with-main-nav home-page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button class="ghost" bindtap="refresh">重新读取</button></view>
  <block wx:else>
    <view class="today-sheet">
      <view class="sheet-binding" aria-hidden="true"><view/><view/><view/><view/><view/><view/></view>
      <view class="row home-meta">
        <view class="sheet-date">{{dateLabel}}<text class="memory-count">{{count}} 件</text></view>
        <view class="home-actions"><button wx:if="{{count}}" id="export-today" class="board-share-button" hover-class="board-share-pressed" aria-label="分享毛毡板" disabled="{{editorOpen || !!placing || recovering}}" bindtap="exportToday"><image class="board-share-icon" src="/images/actions/share.png" mode="aspectFit" aria-hidden="true" /></button></view>
      </view>
      <view class="today-stage"><felt-board id="today-board" layout="tall" style="height:100%;" can-edit="{{canEdit}}" covered="{{editorOpen || !!placing || !!drawer || !!memoryCardId || !!shareBoardId}}" landing-id="{{placing.id || ''}}" model="{{model}}" editable="{{editable}}" selected="{{selected}}" bind:landingready="stickerTarget" bind:select="select" bind:edititem="editItem" bind:change="placementChanged" bind:transform="transform" bind:remove="remove" bind:memory="openMemory" bind:boardtap="openBoard" /></view>
    </view>
    <view wx:if="{{saveError}}" class="error">{{saveError}}<button bindtap="retrySave">重试保存</button></view>
    <view class="record-dock"><include src="../../templates/board-feedback.wxml" /><button id="record-today" class="primary record-fab" hover-class="ui-pressed" disabled="{{editorOpen || !!placing}}" aria-label="{{count ? '再记一件' : '记录今天'}}" bindtap="primary"><text class="record-plus">＋</text><text>{{count ? '再记一件' : '记录今天'}}</text></button></view>
  </block>
</view>
<include src="../../templates/board-drawers.wxml" />
<record-card wx:if="{{editorOpen}}" id="record-card" board-id="{{editorDate}}" lifting="{{!!placing}}" bind:place="startSticker" bind:close="closeEditor" bind:change="editorChanged" />
<sticker-flight id="placement-flight" wx:if="{{placing}}" flight="{{placing}}" bind:peeled="stickerLifted" bind:landed="stickerLanded" />

<memory-card wx:if="{{memoryCardId}}" id="memory-card" memory-id="{{memoryCardId}}" bind:close="closeMemoryCard" bind:change="memoryCardChanged" />
<share-card wx:if="{{shareBoardId}}" id="share-card" board-id="{{shareBoardId}}" viewport="{{shareViewport}}" bind:close="closeShareCard" />
