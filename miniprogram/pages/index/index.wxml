<view class="page with-main-nav home-page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button class="ghost" bindtap="refresh">重新读取</button></view>
  <block wx:else>
    <view class="today-sheet">
      <view class="sheet-binding" aria-hidden="true"><view/><view/><view/><view/><view/><view/></view>
      <view class="row home-meta"><view class="sheet-date">{{dateLabel}}</view><view class="home-actions"><view class="memory-count"><text>{{count}}</text> 件</view><button id="arrange-today" class="ghost" bindtap="openBoard">布置 ⌃</button></view></view>
      <felt-board id="today-board" covered="{{editorOpen}}" model="{{model}}" bind:memory="openMemory" bind:boardtap="openBoard" />
      <button id="record-today" class="primary full record-button" bindtap="primary"><text class="record-star">＋</text>{{count ? '再记一件' : '记录今天'}}</button>
      <button wx:if="{{count}}" id="export-today" class="ghost full" bindtap="exportToday">分享 ↗</button>
    </view>
    <view class="recent-section">
      <view class="row"><text class="section-title">最近记录</text><button class="ghost section-link" bindtap="calendar">全部 ↗</button></view>
      <view wx:if="{{!recent.length}}" class="empty-recent muted">暂无往日记录</view>
      <view wx:else class="recent-grid"><view wx:for="{{recent}}" wx:key="date" class="recent-item" data-date="{{item.date}}" bindtap="recentBoard"><felt-board covered="{{editorOpen}}" model="{{item.model}}" interactive="{{false}}" /><view class="space-small">{{item.label}}</view><view class="muted">{{item.count}} 件记忆</view></view></view>
    </view>
    <view class="collection-links">
      <button id="open-themes" class="collection-link" bindtap="themes"><view class="collection-top"><image class="collection-icon" src="/images/navigation/board-active.png" /><text class="collection-arrow">↗</text></view><text class="collection-title">主题板</text></button>
      <button id="find-memories" class="collection-link" bindtap="memories"><view class="collection-top"><image class="collection-icon" src="/images/navigation/calendar-active.png" /><text class="collection-arrow">↗</text></view><text class="collection-title">记忆分类</text></button>
    </view>
  </block>
</view>
<record-card wx:if="{{editorOpen}}" id="record-card" board-id="{{editorDate}}" start-with-photo="{{startWithPhoto}}" bind:close="closeEditor" bind:change="editorChanged" />
