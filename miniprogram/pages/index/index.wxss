.page.home-page { padding-left:12px; padding-right:12px; gap:8px; }
.home-meta { flex-shrink:0; min-height:44px; padding:0 6px; gap:6px; }
.sheet-date { color:#766457; font-size:12px; white-space:nowrap; }
.memory-count { margin-left:10px; color:#A5998D; font-size:11px; }
.home-actions { display:flex; align-items:center; gap:4px; }
.home-actions button.ghost { font-size:12px; padding:10px 6px; }
.today-stage { flex:1; min-height:0; }
.record-dock { height:56px; flex-shrink:0; display:flex; justify-content:flex-end; padding:0 8px; }
button.record-fab { width:56px; min-width:56px; height:56px; min-height:56px; padding:0; border-radius:50%; font-size:34px; font-weight:400; line-height:52px; box-shadow:0 5px 15px rgba(38,35,33,.16); }
@media (max-width:350px) { .memory-count { margin-left:6px; }.home-actions { gap:0; } }
