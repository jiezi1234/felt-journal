<view class="page {{!editable && !task && !recovering ? 'with-main-nav' : ''}}">
  <view class="row"><button class="ghost" bindtap="back">‹ 返回</button><text class="chip">{{isTheme ? '跨日收藏 · 长期主题' : '每日手账'}}</text></view>
  <include src="../../templates/board-content.wxml" />
</view>
<include src="../../templates/board-drawers.wxml" />
<main-nav wx:if="{{!editable && !task && !recovering && !drawer}}" id="main-nav" active="{{isTheme ? 'board' : 'today'}}" />
<photo-panel task="{{task}}" bind:retry="retryPhoto" bind:original="originalPhoto" bind:cancel="cancelPhoto" />
