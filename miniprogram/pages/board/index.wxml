<view class="page screen-page board-page {{!editable && !task && !recovering ? 'with-main-nav' : ''}}">
  <view class="row"><button class="ghost" bindtap="back">‹ 返回</button><text class="chip">{{isTheme ? '主题板' : '每日手账'}}</text></view>
  <include src="../../templates/board-content.wxml" />
</view>
<include src="../../templates/board-drawers.wxml" />
<main-nav wx:if="{{!editable && !task && !recovering && !drawer}}" id="main-nav" active="{{isTheme ? 'board' : 'today'}}" />
<photo-panel task="{{task}}" lifting="{{!!placing}}" continue-label="继续布置" bind:retry="retryPhoto" bind:original="originalPhoto" bind:cancel="cancelPhoto" />
<sticker-flight id="placement-flight" wx:if="{{placing}}" flight="{{placing}}" bind:peeled="stickerLifted" bind:landed="stickerLanded" />
