@import "../../styles/board-editor.wxss";
.record-overlay { position:fixed; inset:0; z-index:130; display:flex; align-items:flex-end; justify-content:center; padding:16px 12px calc(12px + env(safe-area-inset-bottom)); }
.record-scrim { position:absolute; inset:0; background:rgba(43,35,28,.32); }
.record-card { position:relative; width:100%; max-width:520px; background:#FFFDFA; border:1px solid #FFFFFF; border-radius:32px; overflow:hidden; box-shadow:0 16px 60px rgba(50,38,24,.18); }
.record-handle { width:34px; height:4px; border-radius:3px; margin:10px auto 0; background:#DED7CC; }
.record-header { padding:12px 20px 14px; border-bottom:1px solid #F0EAE1; }.record-header .section-title { font-size:19px; }.record-date { font-size:11px; }
button.record-close { width:44px; height:44px; min-height:44px; border:0; border-radius:50%; padding:0; background:#F2EEE7; color:#82715F; font-size:27px; line-height:42px; }
.record-scroll { height:55vh; }.is-source .record-scroll { height:38vh; }.record-body { padding:18px 16px 24px; }.record-source { padding:10px 4px; }.source-heading { font-size:21px; font-weight:600; color:#6F5540; margin-bottom:10px; }.record-source>.muted { font-size:12px; }.source-actions { display:flex; flex-direction:column; gap:12px; margin-top:24px; }.record-footer { padding:12px 20px 16px; border-top:1px solid #F0EAE1; background:#FFFDFA; }.record-body .board-heading { margin:0 0 14px; }.record-body .board-heading .section-title { font-size:14px; }.record-body .caption { margin:12px 0 16px; }.record-body .paper { margin-top:16px; padding:16px; }.record-body .history-tools { margin:12px 0; }
.record-card .drawer-veil { position:absolute; padding:0; }.record-card .drawer-sheet { border-radius:28px 28px 0 0; max-width:none; max-height:100%; }.record-card .drawer-scroll { max-height:50vh; }
