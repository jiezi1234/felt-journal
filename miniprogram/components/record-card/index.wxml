<view class="record-overlay modal-overlay {{modalClosing ? 'is-closing' : ''}} {{modalKeyboard ? 'has-keyboard' : ''}}" style="{{modalHeight ? 'height:' + modalHeight + 'px;padding-bottom:' + modalBottom + 'px;' : ''}}" catchtouchmove="stop" catchtap="stop">
  <view class="record-scrim modal-scrim" bindtap="back" />
  <view class="record-card modal-surface {{task ? 'is-processing' : 'is-source'}}" role="dialog" aria-modal="true" aria-label="添加记忆">
    <view class="record-handle" aria-hidden="true" />
    <view class="row record-header"><view><view class="section-title">{{isTheme ? '添加记忆' : '记录今天'}}</view><text class="muted record-date">{{dateLabel}}</text></view><button hover-class="ui-pressed" id="close-record" class="record-close ui-close" disabled="{{lifting}}" aria-label="关闭记录卡片" bindtap="back">×</button></view>
    <view class="record-scroll">
      <view class="record-body">
        <view class="record-source {{task ? 'record-source-away' : ''}}" aria-hidden="{{!!task}}">
          <view class="source-intro">留住今天的一件小事</view>
          <view class="source-actions">
            <button hover-class="ui-pressed" id="record-camera" class="source-button" disabled="{{!!task || modalClosing || loading || recovering || !!error}}" bindtap="camera"><view class="source-circle"><view class="source-camera-icon"><view /></view></view><text>拍照</text></button>
            <button hover-class="ui-pressed" id="record-album" class="source-button" disabled="{{!!task || modalClosing || loading || recovering || !!error}}" bindtap="album"><view class="source-circle"><view class="source-album-icon"><view /></view></view><text>相册</text></button>
          </view>
          <view class="source-hint">选好照片，自动提取成贴纸</view>
          <button wx:if="{{isTheme}}" id="source-library" class="ghost record-existing" disabled="{{!!task || modalClosing}}" bindtap="existingMemory">从现有记忆添加</button>
          <view wx:if="{{error}}" class="error">{{error}}</view>
        </view>
        <photo-panel allow-library="{{true}}" library-title="{{photoLibraryTitle}}" bind:libraryopen="openPhotoLibrary" keyboard="{{modalKeyboard}}" adjusting="{{photoAdjusting}}" adjustment-error="{{photoAdjustmentError}}" bind:adjust="adjustPhoto" note-open="{{photoNoteOpen}}" note-text="{{photoNoteText}}" note-error="{{photoNoteError}}" bind:noteopen="openPhotoNote" bind:noteinput="photoNoteInput" wx:if="{{task}}" id="record-photo" style="height:100%; min-height:0;" inline="{{true}}" lifting="{{lifting}}" continue-label="开始布置" task="{{task}}" bind:retry="retryPhoto" bind:original="originalPhoto" bind:cancel="cancelPhoto" bind:continue="continuePhoto" />
      </view>
    </view>
  </view>
</view>

<memory-library wx:if="{{photoLibraryOpen && task.memoryId}}" id="photo-library" mode="pick" memory-id="{{task.memoryId}}" bind:close="closePhotoLibrary" bind:change="photoLibraryChanged" />
