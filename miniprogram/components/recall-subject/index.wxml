<image class="subject-image {{pending ? 'is-pending' : ''}}" src="{{previewPath || path}}" mode="aspectFit" data-path="{{path}}" data-preview="{{previewPath}}" binderror="imageFailed" aria-label="回忆中的物件" />
<!-- Snapshot once, so the native canvas cannot pierce the sheet or its scroll area. -->
<canvas id="subject-canvas" type="2d" class="subject-canvas" aria-hidden="true" />
