<view class="board-viewport {{layout ? 'fitted' : ''}}">
<view class="board-shell" style="height:{{height}}px;{{width ? 'width:' + width + 'px;' : ''}}" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
  <canvas hidden="{{covered}}" type="2d" id="feltCanvas" class="board-canvas" style="height:{{height}}px;" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel" />
  <image wx:if="{{covered && snapshot}}" class="board-snapshot" src="{{snapshot}}" mode="scaleToFill" style="height:{{height}}px;" />
  <block wx:if="{{!covered}}"><button wx:for="{{handles}}" wx:key="op" class="grip" hover-class="none" style="{{item.style}}" data-op="{{item.op}}" aria-label="{{item.label}}" catchtouchstart="controlStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel" catchtap="controlTap" catchlongpress="stop"></button></block>
</view>
<view wx:if="{{imageError}}" class="image-warning">有照片无法读取，可进入记忆详情替换</view>
</view>
