:host { display:block; width:100%; }
.board-shell { position:relative; width:100%; border-radius:24px; box-shadow:0 12px 28px rgba(48,47,43,.13); }
.board-canvas { display:block; width:100%; border-radius:24px; }
/* Faces are drawn in the UI-only canvas pass. Independent native buttons keep
   44px hit targets and accessible labels without native capture layer issues. */
button.grip { position:absolute!important; z-index:10; margin:0!important; width:44px!important; min-width:44px; max-width:44px; height:44px; min-height:44px; padding:0; border-radius:50%; background:transparent; color:transparent; border:0; font-size:28px; line-height:44px; box-shadow:none; }
.grip::after { border:none; }.image-warning { margin-top:12px; color:#944835; font-size:12px; }
