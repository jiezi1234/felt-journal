<view wx:if="{{open}}" class="smooth-overlay recall-overlay {{closing ? 'is-closing' : ''}}" catchtouchmove="stop">
  <view class="smooth-scrim" bindtap="close" />
  <view id="recall-surface" class="smooth-surface recall-surface" role="dialog" aria-modal="true" aria-label="往日一件">
    <view class="smooth-handle" aria-hidden="true" />
    <view class="recall-pane">
      <view class="recall-heading"><view class="section-title grow">往日一件</view><button id="close-recall" class="ghost recall-close" aria-label="关闭回顾" bindtap="close">×</button></view>
      <scroll-view scroll-y class="recall-scroll">
        <block wx:if="{{item}}">
          <view class="recall-content recall-turn-{{turn ? 'a' : 'b'}}">
            <image id="recall-object" class="recall-object" src="{{item.path}}" mode="aspectFit" data-id="{{item.id}}" data-path="{{item.path}}" binderror="imageFailed" />
            <view class="recall-date">{{item.dateLabel}} · {{item.age}}</view>
            <view wx:if="{{item.text}}" class="recall-note">{{item.text}}</view>
          </view>
          <view class="row recall-actions"><button id="next-recall" class="secondary grow" disabled="{{!canNext || closing}}" bindtap="next">再看一件</button><button id="recall-show-day" class="primary grow" disabled="{{closing}}" bindtap="showDay">查看那天 ↗</button></view>
          <button id="hide-recall-item" class="ghost recall-hide" disabled="{{closing}}" bindtap="hideItem">不再回顾这件</button>
        </block>
        <view wx:else class="recall-empty"><view>等待一次久别重逢</view><text>{{hiddenCount ? '之前隐藏的物件，可以随时恢复回顾。' : '过去日子的物件会出现在这里。'}}</text></view>
        <button wx:if="{{hiddenCount}}" id="restore-recall-items" class="ghost recall-restore" disabled="{{closing}}" bindtap="restoreHidden">恢复已隐藏的 {{hiddenCount}} 件物体</button>
        <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      </scroll-view>
    </view>
  </view>
</view>
