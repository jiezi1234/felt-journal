.veil { position:fixed; inset:0; z-index:100; background:rgba(30,44,36,.3); display:flex; align-items:center; justify-content:center; padding:24px; box-sizing:border-box; }
.sheet { width:100%; max-width:430px; max-height:80vh; overflow-y:auto; background:#FFFFFF; border:1px solid #EDF2EE; border-radius:28px; padding:28px 22px 18px; box-shadow:0 20px 60px rgba(30,44,36,.12); }
.title { font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:22px; font-weight:600; line-height:1.5; color:#263530; }
.caption { font-size:12px; color:#68766C; line-height:1.8; margin:10px 0 20px; }
.previews { display:flex; align-items:center; gap:10px; margin:20px 0; }.previews>view { flex:1; min-width:0; text-align:center; font-size:11px; color:#68766C; }
.previews image,.placeholder { width:100%; height:120px; background:#F2F5F3; border-radius:16px; }.placeholder { display:flex; align-items:center; justify-content:center; }.arrow { color:#83998A; font-size:22px; }
.error { color:#97574C; font-size:13px; line-height:1.8; padding:12px; border-radius:12px; background:#FBF4F2; margin:18px 0; }
button { box-sizing:border-box; font-size:14px; min-height:48px; line-height:1.5; padding:13px 8px; margin-top:12px; border:0; border-radius:16px; }button::after { border:0; }
.primary { background:linear-gradient(115deg,#2F443A,#486253); color:#FFFFFF; }.secondary { background:#F2F5F3; color:#435A4E; }.cancel { background:transparent; color:#68766C; }
button.primary,button.secondary,button.cancel { width:100%; }
