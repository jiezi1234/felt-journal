.veil { position:fixed; inset:0; z-index:100; background:rgba(38,32,25,.3); display:flex; align-items:center; justify-content:center; padding:24px 18px; box-sizing:border-box; }
.sheet { width:100%; max-width:430px; max-height:84vh; overflow-y:auto; box-sizing:border-box; background:#F5F4F0; border:1px solid #FFFFFF; border-radius:32px; padding:20px 18px 14px; box-shadow:0 20px 60px rgba(55,40,25,.12); text-align:center; }
.photo-stage { position:relative; display:flex; align-items:center; justify-content:center; width:100%; height:272px; margin:0 auto 18px; overflow:hidden; border-radius:26px; background:#EEECE6; }
.photo-stage.has-subject { background:transparent; }
.task-image { display:block; width:100%; height:100%; }
.has-subject .task-image { width:92%; height:92%; }
.photo-empty { width:100%; height:100%; display:flex; align-items:center; justify-content:center; }
.empty-camera { position:relative; width:48px; height:35px; border:2px solid #CEC7BB; border-radius:10px; }
.empty-camera::before { content:""; position:absolute; width:19px; height:7px; border:2px solid #CEC7BB; border-bottom:0; border-radius:5px 5px 0 0; top:-8px; left:12px; }
.empty-camera view { width:14px; height:14px; border:2px solid #CEC7BB; border-radius:50%; margin:8px auto; }
button.compare-photo { position:absolute; top:12px; right:12px; width:auto; min-height:30px; line-height:20px; padding:5px 12px; margin:0; border:1px solid rgba(255,255,255,.8); border-radius:18px; background:rgba(255,255,255,.88); color:#69594C; font-size:11px; font-weight:400; box-shadow:0 2px 8px rgba(55,40,25,.04); }
.task-copy { margin:16px 0 18px; }
.task-title { font-size:19px; font-weight:500; line-height:1.55; color:#655044; }
.analyzing-pill { height:52px; max-width:100%; width:fit-content; box-sizing:border-box; display:inline-flex; align-items:center; justify-content:center; gap:4px; padding:0 24px 0 20px; margin:2px auto 14px; border-radius:26px; background:rgba(255,255,255,.96); box-shadow:0 2px 10px rgba(255,255,255,.8); }
.star-frame { flex-shrink:0; width:24px; height:24px; display:flex; align-items:center; justify-content:center; }
.pill-star { display:block; color:#FFC552; font-size:25px; line-height:24px; transform-origin:50% 50%; animation:star-turn 960ms cubic-bezier(.167,.167,.667,1) infinite,star-color 960ms cubic-bezier(.167,3.243,.667,1) infinite; }
.sweep-label { position:relative; font-size:16px; font-weight:500; white-space:nowrap; line-height:24px; color:rgba(10,10,10,.16); }
.sweep-ink { position:absolute; top:0; left:0; width:100%; color:transparent; background-image:linear-gradient(90deg,rgba(10,10,10,0) 0%,rgba(10,10,10,.05) 12%,rgba(10,10,10,.15) 25%,rgba(10,10,10,.3) 40%,rgba(10,10,10,.4) 50%,rgba(10,10,10,.3) 60%,rgba(10,10,10,.15) 75%,rgba(10,10,10,.05) 88%,rgba(10,10,10,0) 100%); background-repeat:no-repeat; background-size:76px 100%; background-position:-100px 0; -webkit-background-clip:text; background-clip:text; animation:text-sweep 1250ms linear infinite; }
.error { color:#97574C; font-size:13px; text-align:left; line-height:1.8; padding:12px 14px; border:1px solid #F1E3DF; border-radius:18px; background:#FBF1ED; margin:12px 0; overflow-wrap:break-word; }
.task-actions { width:100%; max-width:320px; margin:0 auto; }
button { box-sizing:border-box; font-size:14px; min-height:48px; line-height:1.5; padding:13px 12px; margin-top:10px; border:0; border-radius:26px; }
button::after { border:0; }
button.primary,button.secondary,button.cancel { width:100%; }
button.primary { background:#171716; color:#FFFFFF; font-weight:500; }
button.secondary { background:#FFFFFF; color:#6E5538; }
button.cancel { min-height:40px; padding:10px 8px; background:transparent; color:#8A7A6C; font-size:12px; }
.is-error .photo-stage { height:214px; }
.inline-panel .sheet { width:100%; max-width:none; max-height:none; padding:2px 0 0; border:0; border-radius:0; box-shadow:none; background:transparent; }
.inline-panel .photo-stage { height:276px; }
.inline-panel .is-error .photo-stage { height:210px; }
.photo-enter { animation:photo-fade 300ms ease-out both,photo-rise 900ms linear both; }
.result-enter { animation:photo-fade 300ms ease-out both; }
/* Approximation of Compose spring(dampingRatio=.72, stiffness=90). */
@keyframes photo-fade { from { opacity:0; } to { opacity:1; } }
@keyframes photo-rise { 0% { transform:translateY(25%); } 11% { transform:translateY(18%); } 22% { transform:translateY(8%); } 33% { transform:translateY(1.8%); } 44% { transform:translateY(-.6%); } 55% { transform:translateY(-.94%); } 66% { transform:translateY(-.6%); } 77% { transform:translateY(-.24%); } 88% { transform:translateY(-.04%); } 100% { transform:translateY(0); } }
@keyframes star-turn { 0% { transform:rotate(0deg) scale(1); } 41.667% { transform:rotate(90deg) scale(.75); } 83.333%,100% { transform:rotate(180deg) scale(1); } }
@keyframes star-color { 0%,83.333%,100% { color:#FFC552; } 41.667% { color:#FFD852; } }
@keyframes text-sweep { from { background-position:-100px 0; } to { background-position:calc(100% + 100px) 0; } }
@media (max-width:350px) { .veil { padding:16px 12px; }.sheet { padding:16px 14px 12px; }.photo-stage,.inline-panel .photo-stage { height:238px; }.is-error .photo-stage,.inline-panel .is-error .photo-stage { height:185px; }.task-title { font-size:18px; } }
@media (max-height:650px) { .photo-stage,.inline-panel .photo-stage { height:220px; }.is-error .photo-stage,.inline-panel .is-error .photo-stage { height:172px; } }

.sheet { height:86vh; max-height:680px; display:flex; flex-direction:column; overflow:visible; }
.photo-stage,.is-error .photo-stage { flex:1; min-height:0; height:0; margin-bottom:10px; }
.task-copy,.analyzing-pill,.error,.task-actions { flex-shrink:0; }.task-copy { margin:8px 0; }.error { margin:6px 0; }
.inline-panel { height:100%; }.inline-panel .sheet { height:100%; max-height:none; }
.inline-panel .photo-stage,.inline-panel .is-error .photo-stage { flex:1; min-height:0; height:0; }
.task-actions button { margin-top:6px; }
button.adjust-photo { width:100%; min-height:40px; padding:8px; font-size:13px; color:#78624E; background:#F1ECE4; }
.photo-note { flex-shrink:0; width:100%; }.photo-note .ghost { width:100%; min-height:36px; padding:6px; font-size:13px; }.photo-note-input { width:100%; height:86px; padding:10px 12px; border-radius:16px; background:#F8F5EF; font-size:14px; line-height:1.7; }.photo-note-count { text-align:right; font-size:10px; color:#95877D; margin-top:3px; }
@media (max-height:570px) { .photo-note-input { height:64px; } }
