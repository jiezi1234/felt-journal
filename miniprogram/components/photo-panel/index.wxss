.veil { position:fixed; inset:0; z-index:100; background:rgba(38,32,25,.3); display:flex; align-items:center; justify-content:center; padding:24px; box-sizing:border-box; }
.sheet { width:100%; max-width:430px; max-height:80vh; overflow-y:auto; background:linear-gradient(145deg,#FFFFFF,#FFFCF6); border:2px solid #FFFFFF; border-radius:34px; padding:28px 22px 18px; box-shadow:0 20px 60px rgba(55,40,25,.12); }
.title { font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:22px; font-weight:700; line-height:1.5; color:#342D26; }
.caption { font-size:12px; color:#8A7A6C; line-height:1.8; margin:10px 0 20px; }
.previews { display:flex; align-items:center; gap:10px; margin:20px 0; }.previews>view { flex:1; min-width:0; text-align:center; font-size:11px; color:#8A7A6C; }
.previews image,.placeholder { width:100%; height:120px; background:#F3EFE6; border-radius:23px; }.placeholder { display:flex; align-items:center; justify-content:center; }.arrow { color:#C4A466; font-size:22px; }
.error { color:#97574C; font-size:13px; line-height:1.8; padding:12px; border-radius:18px; background:#FBF1ED; margin:18px 0; }
button { box-sizing:border-box; font-size:14px; min-height:48px; line-height:1.5; padding:13px 8px; margin-top:12px; border:0; border-radius:28px; }button::after { border:0; }
.primary { background:#171716; color:#FFFFFF; }.secondary { background:#FFF0CA; color:#6E5538; }.cancel { background:transparent; color:#8A7A6C; }
button.primary,button.secondary,button.cancel { width:100%; }
