.veil { position:fixed; inset:0; z-index:100; background:rgba(48,47,43,.38); display:flex; align-items:center; justify-content:center; padding:20px; box-sizing:border-box; }
.sheet { width:100%; max-width:430px; max-height:80vh; overflow-y:auto; background:#F7F2E9; border:1px solid #fff8ea; border-top:6px solid #8FAE92; border-radius:24px; padding:24px 18px 16px; box-shadow:0 12px 28px rgba(48,47,43,.14); }
.title { font:22px/1.5 serif; color:#302F2B; }.caption { font-size:13px; color:#73746D; line-height:1.7; margin:8px 0 18px; }
.previews { display:flex; align-items:center; gap:10px; margin:16px 0; }.previews>view { flex:1; min-width:0; text-align:center; font-size:12px; color:#73746D; }.previews image,.placeholder { width:100%; height:120px; background:#EAE7DB; border-radius:12px; }.placeholder { display:flex; align-items:center; justify-content:center; }.arrow { color:#396848; font-size:26px; }.error { color:#944835; font-size:14px; line-height:1.7; margin:16px 0; }
button { font-size:15px; min-height:44px; line-height:1.5; padding:12px 6px; margin-top:12px; border-radius:12px; }button::after { border:0; }.primary { background:#4D7D5B; color:#F7F2E9; }.secondary { background:#E8EDE7; color:#396848; }.cancel { background:transparent; color:#73746D; }
button.primary,button.secondary,button.cancel { width:100%; }
