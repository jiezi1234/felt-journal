<view wx:if="{{task}}" id="photo-task" class="{{inline ? 'inline-panel' : 'veil'}} {{keyboard ? 'has-keyboard' : ''}}" catchtouchmove="stop">
  <view class="sheet photo-task-sheet {{preview ? 'is-preview' : ''}} {{done ? 'is-done' : ''}} {{failed ? 'is-error' : ''}}">
    <view id="task-preview" style="visibility:{{lifting ? 'hidden' : 'visible'}};" class="photo-stage reveal-{{revealPhase}}">
      <image wx:if="{{subjectSrc}}" id="task-image" class="task-image photo-subject {{subjectVisible ? 'is-visible' : ''}}" style="{{subjectStyle}}" src="{{subjectSrc}}" data-src="{{subjectSrc}}" mode="aspectFit" bindload="subjectLoaded" binderror="subjectFailed" aria-label="照片主体" />
      <view class="photo-original-layer {{originalHidden && !showOriginal ? 'is-hidden' : ''}}">
        <image wx:if="{{originalSrc}}" id="{{canCompare ? 'task-original' : 'task-image'}}" class="task-image" src="{{originalSrc}}" data-src="{{originalSrc}}" mode="aspectFit" bindload="originalLoaded" binderror="originalFailed" aria-label="原始照片" />
        <view wx:else class="photo-empty" aria-hidden="true"><view class="empty-camera"><view /></view></view>
      </view>
      <button hover-class="ui-pressed" wx:if="{{done && canCompare && !revealError}}" id="compare-photo" class="compare-photo" disabled="{{lifting || adjusting || revealBusy}}" bindtap="compare" aria-label="{{showOriginal ? '查看主体' : '查看原图'}}">{{showOriginal ? '看主体' : '看原图'}}</button>
    </view>
    <view class="task-status"><view wx:if="{{analyzing || revealBusy}}" id="analyzing-pill" class="analyzing-pill" role="status" aria-label="{{revealBusy ? '整理贴纸中…' : stageLabel}}">
      <view class="star-frame" aria-hidden="true"><text class="pill-star">✦</text></view>
      <view class="processing-copy"><view class="sweep-label"><text>正在制作贴纸</text><text class="sweep-ink" aria-hidden="true">正在制作贴纸</text></view><text wx:for="{{stageLines}}" wx:key="id" class="stage-caption">{{revealBusy ? '整理贴纸中…' : item.label}}</text></view>
    </view>
    <view wx:if="{{done && !revealBusy}}" id="task-done" class="task-copy result-enter" role="status"><text class="task-title">{{resultLabel}}</text><text class="result-hint">已留在本机，接下来放到板上</text></view>
    <view wx:if="{{failed}}" class="task-copy"><text class="task-title">{{task.state === 'saveError' ? '记忆尚未保存' : task.state === 'sourceError' ? '照片尚未准备好' : '主体尚未提取'}}</text></view></view>
    <view wx:if="{{task.error}}" id="photo-error" class="error">{{task.error}}</view>
    <view wx:if="{{revealError}}" class="error" role="alert">{{revealError}}<button id="retry-photo-preview" class="secondary" bindtap="retryPreview">重试预览</button></view>
    <view wx:if="{{done && (noteOpen || noteError)}}" class="photo-note">
      <block wx:if="{{noteOpen}}"><textarea id="photo-note-input" class="photo-note-input" placeholder="写点什么（选填）" value="{{noteText}}" maxlength="{{maxText}}" disabled="{{lifting || adjusting}}" bindinput="noteInput" adjust-position="{{!inline}}" cursor-spacing="12" /><view class="photo-note-count">{{noteText.length}} / {{maxText}}</view></block>
      <view wx:if="{{noteError}}" class="error">{{noteError}}</view>
    </view>
    <view class="task-actions">
      <view wx:if="{{adjustmentError}}" class="error">{{adjustmentError}}</view>
      <view wx:if="{{done}}" class="result-tools"><button hover-class="ui-pressed" id="adjust-photo" class="adjust-photo" disabled="{{lifting || adjusting || revealBusy}}" loading="{{adjusting}}" bindtap="adjust">调整图片</button><button hover-class="ui-pressed" wx:if="{{!noteOpen}}" id="add-photo-note" class="note-action" disabled="{{lifting || adjusting || revealBusy}}" bindtap="openNote">{{noteText ? '编辑说明' : '添加说明 · 选填'}}</button></view>
      <button hover-class="ui-pressed" wx:if="{{done}}" id="continue-layout" class="primary" disabled="{{lifting || adjusting || revealBusy || revealError}}" bindtap="cancel">{{continueLabel}}</button>
      <button hover-class="ui-pressed" wx:if="{{task.state === 'extractError'}}" id="retry-extraction" class="primary" bindtap="retry">重新提取</button>
      <button hover-class="ui-pressed" wx:if="{{task.state === 'saveError'}}" id="retry-photo-save" class="primary" bindtap="retry">重试保存</button>
      <button hover-class="ui-pressed" wx:if="{{task.state === 'sourceError'}}" id="reselect-photo" class="primary" bindtap="retry">重新选图</button>
      <button hover-class="ui-pressed" wx:if="{{task.state === 'extractError'}}" id="keep-original" class="secondary" bindtap="original">使用原图继续</button>
      <button hover-class="ui-pressed" wx:if="{{task.permission}}" id="photo-permission" class="secondary" bindtap="settings">打开权限设置</button>
      <button hover-class="ui-pressed" wx:if="{{!done}}" id="cancel-photo" class="cancel" bindtap="cancel">{{analyzing ? '取消处理' : '返回'}}</button>
    </view>
  </view>
</view>
