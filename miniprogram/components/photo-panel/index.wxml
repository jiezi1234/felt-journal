<view wx:if="{{task}}" class="veil" catchtouchmove="stop"><view class="sheet">
  <view class="title">{{task.state === 'extractError' ? '照片主体还未提取' : task.state === 'saveError' ? '记录尚未保存' : task.state === 'sourceError' ? '照片尚未准备好' : task.state === 'saving' ? '正在保存记忆' : task.state === 'choosing' ? '请选择一张照片' : task.state === 'persisting' ? '正在保存原图' : task.state === 'uploading' ? '正在上传照片' : '正在获取照片主体'}}</view>
  <view class="caption">完成后会直接回到发起记录的毛毡板</view>
  <view wx:if="{{task.original}}" class="previews"><view><image src="{{task.original}}" mode="aspectFit" /><text>原始照片</text></view><text class="arrow">→</text><view><image wx:if="{{task.subject}}" src="{{task.subject}}" mode="aspectFit" /><view wx:else class="placeholder">等待处理结果</view><text>物件预览</text></view></view>
  <view wx:if="{{task.error}}" class="error">{{task.error}}</view><view wx:else class="caption">正在处理，请稍候…</view>
  <button wx:if="{{task.state === 'extractError'}}" class="primary" bindtap="retry">重新提取</button><button wx:if="{{task.state === 'saveError'}}" class="primary" bindtap="retry">重试保存</button><button wx:if="{{task.state === 'sourceError'}}" class="primary" bindtap="retry">重新选图</button>
  <button wx:if="{{task.state === 'extractError'}}" class="secondary" bindtap="original">使用原图继续（保留矩形）</button><button wx:if="{{task.permission}}" class="secondary" bindtap="settings">打开权限设置</button><button class="cancel" bindtap="cancel">取消并返回</button>
</view></view>
