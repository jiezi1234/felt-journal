<view wx:if="{{task}}" id="photo-task" class="{{inline ? 'inline-panel' : 'veil'}}" catchtouchmove="stop">
  <view class="sheet photo-task-sheet {{preview ? 'is-preview' : ''}} {{done ? 'is-done' : ''}} {{failed ? 'is-error' : ''}}">
    <view id="task-preview" class="photo-stage {{canCompare && !showOriginal ? 'has-subject' : 'has-original'}}">
      <image wx:if="{{canCompare && !showOriginal}}" id="task-image" class="task-image photo-enter" src="{{displayImage}}" mode="aspectFit" aria-label="照片主体" />
      <image wx:elif="{{displayImage}}" id="task-image" class="task-image photo-enter" src="{{displayImage}}" mode="aspectFit" aria-label="原始照片" />
      <view wx:else class="photo-empty" aria-hidden="true"><view class="empty-camera"><view /></view></view>
      <button wx:if="{{canCompare}}" id="compare-photo" class="compare-photo" bindtap="compare" aria-label="{{showOriginal ? '查看主体' : '查看原图'}}">{{showOriginal ? '看主体' : '看原图'}}</button>
    </view>
    <view wx:if="{{analyzing}}" id="analyzing-pill" class="analyzing-pill" role="status" aria-label="{{stageLabel}}">
      <view class="star-frame" aria-hidden="true"><text class="pill-star">✦</text></view>
      <view class="sweep-label"><text>{{stageLabel}}</text><text class="sweep-ink" aria-hidden="true">{{stageLabel}}</text></view>
    </view>
    <view wx:if="{{preview}}" class="task-copy"><text class="task-title">照片已就绪</text></view>
    <view wx:if="{{done}}" id="task-done" class="task-copy result-enter" role="status"><text class="task-title">{{resultLabel}}</text></view>
    <view wx:if="{{failed}}" class="task-copy"><text class="task-title">{{task.state === 'saveError' ? '记忆尚未保存' : task.state === 'sourceError' ? '照片尚未准备好' : '主体尚未提取'}}</text></view>
    <view wx:if="{{task.error}}" id="photo-error" class="error">{{task.error}}</view>
    <view class="task-actions">
      <button wx:if="{{preview}}" id="start-extraction" class="primary" bindtap="retry">开始提取</button>
      <button wx:if="{{done}}" id="continue-layout" class="primary" bindtap="cancel">{{continueLabel}}</button>
      <button wx:if="{{task.state === 'extractError'}}" id="retry-extraction" class="primary" bindtap="retry">重新提取</button>
      <button wx:if="{{task.state === 'saveError'}}" id="retry-photo-save" class="primary" bindtap="retry">重试保存</button>
      <button wx:if="{{task.state === 'sourceError'}}" id="reselect-photo" class="primary" bindtap="retry">重新选图</button>
      <button wx:if="{{task.state === 'extractError'}}" id="keep-original" class="secondary" bindtap="original">使用原图继续</button>
      <button wx:if="{{task.permission}}" id="photo-permission" class="secondary" bindtap="settings">打开权限设置</button>
      <button wx:if="{{!done}}" id="cancel-photo" class="cancel" bindtap="cancel">{{analyzing ? '取消处理' : '返回'}}</button>
    </view>
  </view>
</view>
