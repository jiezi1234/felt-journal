@import "../../styles/modal.wxss";
.share-card-overlay { position:fixed; inset:0; z-index:180; padding:14px 16px calc(14px + env(safe-area-inset-bottom)); display:flex; align-items:center; justify-content:center; }
.share-card-backdrop { position:absolute; inset:0; background:rgba(43,35,28,.26); }
.share-card-dialog { position:relative; width:100%; max-width:520px; height:84vh; max-height:740px; min-height:0; display:flex; flex-direction:column; gap:10px; padding:18px; overflow:hidden; border:1px solid #FFFFFF; border-radius:30px; background:linear-gradient(145deg,#FFFFFF,#FFFCF6); box-shadow:0 16px 48px rgba(45,35,25,.14); animation:share-rise-in .18s ease-out; }
.share-card-heading { flex-shrink:0; gap:12px; }.share-card-heading>view { flex:1; min-width:0; }.share-card-heading .section-title { font-size:20px; }.share-card-date { display:block; font-size:12px; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
button.share-card-close { flex-shrink:0; width:40px; min-width:40px; min-height:40px; height:40px; padding:0; font-size:26px; line-height:38px; }
.share-card-dialog .share-card-preview { flex:1; min-height:0; display:flex; padding:10px; margin:0; border-radius:22px; background:linear-gradient(145deg,#FAF9F6,#F2EEE7); box-shadow:none; }
.share-card-image { flex:1; min-width:0; width:100%; height:100%; border-radius:12px; }.share-card-placeholder { flex:1; display:flex; align-items:center; justify-content:center; font-size:12px; }
button.share-card-style { flex-shrink:0; width:100%; min-height:42px; margin:0; padding:8px 12px; border:1px solid #EEE8DF; border-radius:16px; font-size:13px; text-align:left; }
.share-card-actions { flex-shrink:0; display:flex; flex-direction:column; gap:8px; }.share-card-actions button { min-height:44px; padding:10px 12px; font-size:14px; }.share-card-actions .secondary { background:#F3F1ED; }
.share-card-error { flex-shrink:0; max-height:90px; overflow-y:auto; font-size:12px; line-height:1.5; color:#97574C; padding:8px 10px; border-radius:12px; background:#FBF4F2; }.share-card-error button { min-height:32px; font-size:12px; padding:4px; }
.share-card-hint { font-size:12px; line-height:1.5; text-align:center; padding:0 4px; }.share-export-canvas { position:fixed; left:-3000px; top:-3000px; width:360px; height:240px; pointer-events:none; }
.share-style-veil { position:absolute; inset:0; z-index:2; display:flex; align-items:flex-end; }.share-style-scrim { position:absolute; inset:0; background:rgba(43,35,28,.2); }
.share-style-sheet { position:relative; width:100%; padding:16px; border-radius:24px 24px 0 0; background:#FFFDF9; box-shadow:0 -6px 24px rgba(45,35,25,.1); animation:share-rise-in .18s ease-out; }
.share-style-heading { gap:8px; font-size:14px; }.share-style-heading .muted { font-size:12px; margin-top:3px; }.share-style-heading button { min-height:40px; padding:8px; font-size:12px; }
.share-colors { display:flex; justify-content:space-between; gap:6px; margin:16px 0; }.share-colors button.share-color { min-width:32px; width:32px; height:32px; min-height:32px; padding:0; border-radius:50%; margin:0; border:2px solid transparent; color:#5F5445; line-height:28px; }.share-colors button.active { border-color:#6C5B46; }.share-color::after { border:0; }
.share-textures { display:flex; gap:6px; }.share-textures button { flex:1; min-width:0; min-height:36px; padding:6px 2px; font-size:12px; border-radius:12px; background:#F4F0E8; color:#9A8A7C; }.share-textures button.active { background:#6C5B46; color:#FFFFFF; }
@keyframes share-fade-in { from { opacity:0; } to { opacity:1; } } @keyframes share-rise-in { from { opacity:.5; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
@media (max-height:570px) { .share-card-dialog { height:88vh; padding:12px; gap:6px; }.share-card-actions { gap:5px; }.share-card-actions button { min-height:38px; padding:7px 10px; }.share-card-error { max-height:66px; }.share-style-sheet { padding:12px; } }
.share-card-dialog { max-height:min(740px,100%); }
.share-style-sheet { max-height:100%; overflow-y:auto; }
