.main-nav { position:fixed; left:0; right:0; bottom:0; z-index:80; padding:4px 16px 0; background:linear-gradient(180deg,rgba(245,245,245,0),#F5F5F5 30%); padding-bottom:constant(safe-area-inset-bottom); padding-bottom:env(safe-area-inset-bottom); }
.main-nav__items { height:80px; max-width:520px; margin:0 auto 8px; padding:5px 16px; display:flex; align-items:center; box-sizing:border-box; background:#FFFFFF; border:1px solid #FFFFFF; border-radius:36px; box-shadow:0 3px 18px rgba(68,52,36,.06); }
button.main-nav__item { position:relative; flex:1; width:0; min-width:44px; height:64px; min-height:44px; margin:0; padding:5px 0; border:0; border-radius:28px; background:transparent; color:#9A948D; line-height:1.4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; box-sizing:border-box; }
button.main-nav__item::after { border:0; }
.main-nav__icon-wrap { display:flex; align-items:center; justify-content:center; width:40px; height:28px; border-radius:15px; }
button.main-nav__item.is-active { color:#5E4B40; font-weight:600; }
.is-active .main-nav__icon-wrap { background:#FFF0C8; }
button.main-nav__item.nav-pressed { background:#F6F3EC; }
button.main-nav__item[disabled] { opacity:.65; }
.main-nav__icon { width:23px; height:23px; flex-shrink:0; }.main-nav__label { font-size:12px; letter-spacing:.2px; }
