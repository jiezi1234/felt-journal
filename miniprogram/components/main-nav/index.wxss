.main-nav { position:fixed; left:0; right:0; bottom:0; z-index:80; background:rgba(247,242,233,.97); box-shadow:0 -4px 16px rgba(48,47,43,.06); padding-bottom:constant(safe-area-inset-bottom); padding-bottom:env(safe-area-inset-bottom); }
.main-nav__items { height:64px; max-width:560px; margin:0 auto; padding:0 16px; display:flex; align-items:center; box-sizing:border-box; }
button.main-nav__item { flex:1; width:0; min-width:44px; height:60px; min-height:44px; margin:0; padding:6px 0; border:0; border-radius:0; background:transparent; color:#615950; line-height:1.4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; box-sizing:border-box; }
button.main-nav__item::after { border:0; }
button.main-nav__item.is-active { color:#396848; font-weight:600; }
button.main-nav__item[disabled] { background:transparent; opacity:.65; }
.main-nav__icon { width:24px; height:24px; flex-shrink:0; }
.main-nav__label { font-size:11px; letter-spacing:.3px; }
