<view class="main-nav">
  <view class="main-nav__items">
    <button wx:for="{{items}}" wx:key="id" id="nav-{{item.id}}" class="main-nav__item {{active === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" disabled="{{navigating}}" bindtap="open" aria-label="{{item.label + (active === item.id ? '，当前页面' : '')}}">
      <image class="main-nav__icon" src="{{'/images/navigation/' + item.id + (active === item.id ? '-active' : '') + '.png'}}" mode="aspectFit" />
      <text class="main-nav__label">{{item.label}}</text>
    </button>
  </view>
</view>
