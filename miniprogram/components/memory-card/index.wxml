<view class="memory-card-overlay modal-overlay material-{{cardStyle}} {{editing ? 'is-editing' : ''}} {{pickupEnabled ? 'has-pickup pickup-' + pickupPhase : ''}} {{modalClosing ? 'is-closing' : ''}} {{modalKeyboard ? 'has-keyboard' : ''}}" style="{{modalHeight ? 'height:' + modalHeight + 'px;padding-bottom:' + modalBottom + 'px;' : ''}}" catchtouchmove="stop" catchtap="stop">
  <view class="memory-card-scrim modal-scrim" bindtap="close" />
  <view class="memory-card-dialog modal-surface" role="dialog" aria-modal="true" aria-label="记忆卡片">
    <view class="row card-heading"><text class="muted card-heading-date">{{dateLabel}}</text><button wx:if="{{memory}}" id="add-to-memory-library" class="card-library-button" disabled="{{pickupBusy || flipBusy || editing || themeOpen}}" bindtap="openLibraries">{{libraryCount ? '记忆库 · ' + libraryCount : '加入记忆库'}}</button><button hover-class="ui-pressed" id="close-memory-card" class="ghost ui-close" aria-label="关闭记忆卡片" disabled="{{pickupBusy}}" bindtap="close">×</button></view>
    <view wx:if="{{!memory}}" class="error">{{error}}</view>
    <view wx:else id="pickup-paper" class="flip-scene" animation="{{pickupPaperAnimation}}">
      <view id="flip-card" class="flip-card {{flipped ? 'is-flipped' : ''}} {{turning ? 'is-turning' : ''}} {{flipBusy ? 'is-flipping' : ''}}" bindtap="flip" role="button" aria-label="{{flipped ? '翻回图片' : '翻到文字说明'}}">
        <view class="card-face card-front" aria-hidden="{{flipped}}">
          <view wx:if="{{cardStyle === 'ticket'}}" class="card-ticket-paper" aria-hidden="true"><view class="card-paper-grain" /></view>
          <view wx:else class="card-paper-grain" aria-hidden="true" />
          <view wx:if="{{cardStyle === 'polaroid'}}" class="card-tape" aria-hidden="true" />
          <view wx:if="{{cardStyle === 'cotton'}}" class="card-front-header"><text>日 常 藏 物</text><text>{{cardDate}}</text></view>
          <view wx:if="{{cardStyle === 'ticket'}}" class="card-ticket-stub">
            <view class="card-ticket-date"><text class="card-ticket-day">{{cardDay}}</text><text class="card-ticket-month">{{cardMonth}}</text></view>
            <view class="card-ticket-titles"><text class="card-ticket-title">生活存根</text><text class="card-ticket-sub">{{cardYear}} · 日常收藏</text></view><view class="card-ticket-mark" aria-hidden="true" />
          </view>
          <text wx:if="{{cardStyle === 'ticket'}}" class="card-ticket-overline">此刻留存</text>
          <view class="card-photo-well">
            <view wx:if="{{cardStyle === 'polaroid'}}" class="card-window-light" aria-hidden="true" />
            <image wx:if="{{!missing}}" id="card-photo" class="card-photo {{pickupEnabled && pickupPhase !== 'open' && pickupPhase !== 'closing' ? 'pickup-photo-hidden' : ''}}" src="{{memory.subjectPath}}" mode="aspectFit" bindload="pickupPhotoLoaded" binderror="imageError" />
            <view wx:else class="card-image-missing">图片暂时无法读取</view>
          </view>
          <view class="card-caption"><text class="card-caption-line">{{frontCaption}}</text><text class="card-caption-sub">{{cardStyle === 'polaroid' ? cardDate : cardStyle === 'ticket' ? '留给日后的自己' : '把这一刻，轻轻收好'}}</text></view>
          <view class="card-front-footer"><text class="card-emboss">{{cardStyle === 'polaroid' ? '日常的一个切片' : cardStyle === 'ticket' ? '生 活 留 存' : '一 日 一 记'}}</text><text class="card-cue">轻触翻面 ↗</text></view>
        </view>
        <view class="card-face card-back" aria-hidden="{{!flipped}}">
          <view wx:if="{{cardStyle === 'ticket'}}" class="card-ticket-paper" aria-hidden="true"><view class="card-paper-grain" /></view>
          <view wx:else class="card-paper-grain" aria-hidden="true" />
          <view wx:if="{{cardStyle === 'ticket'}}" class="card-ticket-stub">
            <view class="card-ticket-date"><text class="card-ticket-day">{{cardDay}}</text><text class="card-ticket-month">{{cardMonth}}</text></view>
            <view class="card-ticket-titles"><text class="card-ticket-title">当时的心情</text><text class="card-ticket-sub">{{cardYear}} · 写给未来</text></view><view class="card-ticket-mark" aria-hidden="true" />
          </view>
          <view wx:else class="card-note-heading"><text class="card-note-date">{{cardDate}}</text><text class="card-note-title">{{cardStyle === 'polaroid' ? '相片背后的小记' : '这一刻，想留下'}}</text><view class="card-heading-rule" /></view>
          <block wx:if="{{flipped && editing}}">
            <view class="card-note-zone"><textarea id="card-note-input" class="card-note-input" value="{{text}}" focus="{{noteFocus}}" maxlength="{{maxText}}" placeholder="写下想留住的话……" placeholder-class="card-note-placeholder" bindinput="input" bindfocus="noteFocused" bindblur="noteBlurred" catchtap="stop" adjust-position="{{false}}" cursor-spacing="12" /></view>
            <view class="card-note-meta"><text>写在这一天</text><text class="note-count">{{text.length}} / {{maxText}}</text></view>
            <view wx:if="{{hint}}" class="muted">{{hint}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
            <view class="row card-note-actions" catchtap="stop"><button hover-class="ui-pressed" id="cancel-card-note" class="ghost" bindtap="cancelEdit">取消</button><button hover-class="ui-pressed" id="save-card-note" class="primary" bindtap="save">保存记录</button></view>
          </block>
          <block wx:else>
            <view class="card-note-zone"><scroll-view wx:if="{{flipped && memory.text}}" class="card-note-reading" scroll-y><view class="card-note">{{memory.text}}</view></scroll-view><view wx:elif="{{!memory.text}}" class="card-empty">还没有留下文字。<text>写一两句，留给以后的自己。</text></view></view>
            <view class="card-note-meta"><text>{{cardStyle === 'polaroid' ? '今天的小小美好' : cardStyle === 'ticket' ? '这一页，为自己保留' : '写在这一天'}}</text><text class="card-cue">轻触翻回图片</text></view>
            <view class="row card-back-actions" catchtap="stop"><button hover-class="ui-pressed" id="edit-card-note" class="secondary" disabled="{{flipBusy}}" bindtap="edit">{{memory.text ? '编辑记录' : '写下记录'}}</button><button hover-class="ui-pressed" wx:if="{{flipped}}" id="add-to-theme" class="ghost" disabled="{{flipBusy}}" bindtap="openThemes">放入主题板</button></view>
          </block>
          <block wx:if="{{flipped && themeOpen}}">
            <view class="card-theme-scrim" catchtap="closeThemes" />
            <view id="card-theme-picker" class="card-theme-picker" catchtap="stop" role="dialog" aria-label="放入主题板">
              <view class="row card-theme-heading"><text class="grow">{{themeCreating ? '新建主题板' : '放入主题板'}}</text><button hover-class="ui-pressed" id="close-card-themes" class="ghost" disabled="{{themeWorking}}" bindtap="closeThemes" aria-label="关闭主题板选择">×</button></view>
              <block wx:if="{{themeCreating}}">
                <input id="card-theme-title" class="card-theme-input" value="{{themeTitle}}" maxlength="{{maxThemeTitle}}" placeholder="如：旅行、美食" disabled="{{themeWorking}}" bindinput="themeInput" />
                <view wx:if="{{themeError}}" class="error">{{themeError}}</view>
                <view class="row"><button hover-class="ui-pressed" id="cancel-card-theme-create" class="ghost grow" disabled="{{themeWorking}}" bindtap="cancelThemeCreate">返回</button><button hover-class="ui-pressed" id="save-card-theme" class="primary grow" loading="{{themeWorking}}" disabled="{{themeWorking}}" bindtap="saveTheme">创建并放入</button></view>
              </block>
              <block wx:else>
                <view wx:if="{{!themes.length && !themeError}}" class="card-theme-empty muted">暂无主题板</view>
                <button hover-class="ui-pressed" wx:for="{{visibleThemes}}" wx:key="id" class="card-theme-row" data-id="{{item.id}}" disabled="{{themeWorking || item.placed || item.full}}" bindtap="placeTheme"><text class="card-theme-name">{{item.title}}</text><text class="card-theme-status">{{item.placed ? '已添加' : item.full ? '已满' : '＋'}}</text></button>
                <view wx:if="{{themePageCount > 1 && themes.length}}" class="row card-theme-pagination"><button hover-class="ui-pressed" id="previous-card-theme" class="ghost" data-offset="-1" disabled="{{themeWorking || themePage <= 1}}" bindtap="turnThemes">‹</button><text class="grow">{{themePage}} / {{themePageCount}}</text><button hover-class="ui-pressed" id="next-card-theme" class="ghost" data-offset="1" disabled="{{themeWorking || themePage >= themePageCount}}" bindtap="turnThemes">›</button></view>
                <view wx:if="{{themeError}}" class="error">{{themeError}}</view>
                <button hover-class="ui-pressed" id="new-card-theme" class="ghost full" disabled="{{themeWorking}}" bindtap="createTheme">＋ 新建主题板</button>
              </block>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>
  <image wx:if="{{pickupEnabled && memory && !missing}}" id="pickup-photo" class="memory-pickup-photo" src="{{memory.subjectPath}}" mode="aspectFit" style="{{pickupFlightStyle}}" animation="{{pickupPhotoAnimation}}" bindload="pickupFlightLoaded" binderror="pickupFailed" aria-hidden="true" />
</view>
<memory-library wx:if="{{libraryPickerOpen}}" id="memory-library-picker" mode="pick" memory-id="{{memoryId}}" bind:close="closeLibraries" bind:change="librariesChanged" />
